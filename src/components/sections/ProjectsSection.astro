---
import TechHobbyOrnaments from '../doodles/TechHobbyOrnaments.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';
import { getProjectsData, pickLocale } from '../../lib/content';

interface Props {
  mode?: 'home' | 'archive';
}

const { mode = 'home' } = Astro.props;
const isArchive = mode === 'archive';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const allProjects = await getProjectsData(false);

const homeHref = getLocalizedPath('/', locale);
const isExternalUrl = (url: string) => /^https?:\/\//i.test(url.trim());

const categoryOrder = ['enterprise', 'ai', 'web', 'gis', 'mobile', 'game', 'network', 'other'] as const;

const categoryMeta: Record<
  string,
  { id: string; en: string; badge: string; dot: string }
> = {
  all: { id: 'Semua', en: 'All', badge: 'bg-ink text-paper', dot: 'bg-ink' },
  enterprise: {
    id: 'Sistem Kantor & Perbankan',
    en: 'Enterprise & Banking',
    badge: 'bg-cobalt text-paper',
    dot: 'bg-cobalt',
  },
  ai: {
    id: 'AI, Data & Kuantitatif',
    en: 'AI, Data & Quant',
    badge: 'bg-mustard text-ink',
    dot: 'bg-mustard',
  },
  web: {
    id: 'Web App & Utilitas',
    en: 'Web Apps & Utilities',
    badge: 'bg-tomato text-paper',
    dot: 'bg-tomato',
  },
  gis: {
    id: 'Geospasial & 3D',
    en: 'Geospatial & 3D',
    badge: 'bg-leaf text-paper',
    dot: 'bg-leaf',
  },
  mobile: {
    id: 'Mobile App',
    en: 'Mobile Apps',
    badge: 'bg-cobalt text-paper',
    dot: 'bg-cobalt',
  },
  game: {
    id: 'Game & Kreatif',
    en: 'Games & Creative',
    badge: 'bg-blush text-ink',
    dot: 'bg-blush',
  },
  network: {
    id: 'Jaringan & Sistem',
    en: 'Networking & Systems',
    badge: 'bg-leaf text-paper',
    dot: 'bg-leaf',
  },
  other: {
    id: 'Eksperimen Lainnya',
    en: 'Other Experiments',
    badge: 'bg-paper-2 text-ink',
    dot: 'bg-ink-soft',
  },
};

const groupedMap = new Map<string, typeof allProjects>();
for (const entry of allProjects) {
  const cat = entry.data.category || 'other';
  const list = groupedMap.get(cat) ?? [];
  list.push(entry);
  groupedMap.set(cat, list);
}

const orderedGroups = [
  ...categoryOrder.filter((cat) => groupedMap.has(cat)),
  ...Array.from(groupedMap.keys()).filter(
    (cat) => !(categoryOrder as readonly string[]).includes(cat),
  ),
].map((cat) => ({
  key: cat,
  meta: categoryMeta[cat] ?? categoryMeta.other,
  items: groupedMap.get(cat) ?? [],
}));

const liveDemoCount = allProjects.filter((p) => isExternalUrl(p.data.demoUrl)).length;
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class={isArchive ? 'mx-auto max-w-5xl space-y-6' : 'desk-section-projects scroll-mt-20'}
>
  {
    isArchive && (
      <div class="flex flex-wrap items-center justify-between gap-3">
        <a
          href={homeHref}
          class="sticker-btn bg-paper-2 text-ink rounded-sm px-3.5 py-1.5 font-mono text-xs"
        >
          &larr; {locale === 'id' ? 'Kembali ke meja' : 'Back to desk'}
        </a>
        <span class="font-hand text-cobalt -rotate-1 text-base">
          ✎ {t('projects.marginNote')}
        </span>
      </div>
    )
  }

  <!-- Header Ringkas -->
  <div class="mb-5 flex flex-col justify-between gap-3 border-b-2 border-ink pb-4 sm:flex-row sm:items-end">
    <div class="max-w-2xl space-y-1.5">
      <div class="flex items-center gap-2.5">
        <span class="bg-tomato text-paper inline-block rounded-sm border-2 border-ink px-2 py-0.5 font-mono text-xs font-bold uppercase shadow-[2px_2px_0_var(--ink)]">
          {isArchive ? '/PROJECTS · INDEKS KARYA' : '01 · PROJECTS'}
        </span>
        <TechHobbyOrnaments variant="rocket" class="h-8 w-7" />
      </div>
      {
        isArchive ? (
          <h1 id="projects-heading" class="font-display text-3xl font-extrabold sm:text-4xl">
            {t('projects.heading')}
          </h1>
        ) : (
          <h2 id="projects-heading" class="font-display text-3xl font-extrabold sm:text-4xl">
            {t('projects.heading')}
          </h2>
        )
      }
      <p class="text-ink-soft text-sm leading-relaxed">
        {locale === 'id'
          ? `Indeks sederhana berisi ${allProjects.length} proyek yang dikelompokkan per kategori. Klik judul untuk membuka live demo, atau klik detail untuk catatan teknisnya.`
          : `A compact index of ${allProjects.length} projects grouped by category. Click any title to open its live demo, or detail for technical notes.`}
      </p>
    </div>

    <span class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-sm border-2 border-ink bg-leaf/15 px-2.5 py-1 font-mono text-[11px] font-bold text-leaf sm:self-end">
      <span class="h-2 w-2 rounded-full bg-leaf" aria-hidden="true" />
      <span>{`${liveDemoCount} ${locale === 'id' ? 'Live' : 'Live'}`}</span>
    </span>
  </div>

  <!-- Filter Kategori + Cari Cepat -->
  <div class="mb-5 flex flex-col gap-3 rounded-md border-2 border-ink bg-paper-2 p-3 sm:flex-row sm:items-center sm:justify-between shadow-[3px_3px_0_var(--ink)]">
    <div
      class="flex flex-wrap items-center gap-1.5"
      role="group"
      aria-label={locale === 'id' ? 'Filter kategori proyek' : 'Filter project category'}
    >
      <button
        type="button"
        data-project-filter="all"
        aria-pressed="true"
        class="inline-flex items-center gap-1.5 rounded-sm border-2 border-ink bg-ink px-2.5 py-1 font-mono text-xs font-bold text-paper shadow-[2px_2px_0_var(--mustard)] transition-all"
      >
        <span>{categoryMeta.all[locale]}</span>
        <span data-count-badge class="rounded-sm bg-mustard px-1.5 text-[10px] text-ink">
          {allProjects.length}
        </span>
      </button>

      {orderedGroups.map((group) => (
        <button
          type="button"
          data-project-filter={group.key}
          aria-pressed="false"
          class="inline-flex items-center gap-1.5 rounded-sm border-2 border-ink bg-paper px-2.5 py-1 font-mono text-xs font-bold text-ink transition-all hover:bg-mustard/35"
        >
          <span>{group.meta[locale]}</span>
          <span data-count-badge class="rounded-sm bg-paper-2 px-1.5 text-[10px] text-ink-soft">
            {group.items.length}
          </span>
        </button>
      ))}
    </div>

    <div class="flex items-center gap-2 sm:w-56">
      <label for="project-search-input" class="sr-only">
        {locale === 'id' ? 'Cari proyek' : 'Search projects'}
      </label>
      <input
        id="project-search-input"
        type="search"
        data-project-search
        placeholder={locale === 'id' ? 'Cari judul / stack...' : 'Search title / stack...'}
        class="w-full rounded-sm border-2 border-ink bg-paper px-2.5 py-1 font-mono text-xs text-ink placeholder:text-ink-soft/75 focus:outline-none focus:ring-2 focus:ring-mustard"
      />
    </div>
  </div>

  <!-- INDEKS PER KATEGORI (2 Kolom di Desktop, Siap 25+ Proyek Tanpa Scroll Panjang) -->
  <div class="grid gap-5 md:grid-cols-2" data-project-groups>
    {
      orderedGroups.map((group) => (
        <section
          data-project-group={group.key}
          class="sticker-card flex flex-col rounded-md bg-paper p-4 sm:p-5"
        >
          <!-- Judul Kategori -->
          <div class="mb-3 flex items-center justify-between gap-2 border-b-2 border-dashed border-ink/25 pb-2.5">
            <div class="flex items-center gap-2">
              <span
                class={`h-2.5 w-2.5 shrink-0 rounded-full border border-ink ${group.meta.dot}`}
                aria-hidden="true"
              />
              <h3 class="font-display text-base font-extrabold text-ink sm:text-lg">
                {group.meta[locale]}
              </h3>
            </div>
            <span
              data-group-count
              class={`rounded-sm border border-ink px-2 py-0.2 font-mono text-[10px] font-bold ${group.meta.badge}`}
            >
              {group.items.length}
            </span>
          </div>

          <!-- Daftar Judul Minimalis dengan tanda "-" -->
          <ul class="divide-y divide-dashed divide-ink/15">
            {group.items.map((entry) => {
              const summary = pickLocale(entry.data.summary, locale);
              const detailHref = getLocalizedPath(`/projects/${entry.id}`, locale);
              const hasExternalDemo = isExternalUrl(entry.data.demoUrl);
              const primaryHref = hasExternalDemo ? entry.data.demoUrl : detailHref;
              const shortTitle = entry.data.title.split('—')[0]?.trim() || entry.data.title;
              const subTitle = entry.data.title.includes('—')
                ? entry.data.title.split('—').slice(1).join('—').trim()
                : entry.data.tagline;
              const searchableText = [
                entry.data.title,
                entry.data.tagline,
                summary,
                group.meta[locale],
                entry.data.category,
                ...entry.data.stack,
                ...entry.data.tags,
              ]
                .join(' ')
                .toLowerCase();

              return (
                <li
                  data-project-item
                  data-category={group.key}
                  data-search={searchableText}
                  class="group flex items-start justify-between gap-3 py-2.5 first:pt-1 last:pb-0"
                >
                  <div class="flex min-w-0 items-baseline gap-2">
                    <span class="font-mono text-xs font-bold text-tomato select-none" aria-hidden="true">
                      -
                    </span>
                    <div class="min-w-0">
                      <a
                        href={primaryHref}
                        target={hasExternalDemo ? '_blank' : undefined}
                        rel={hasExternalDemo ? 'noopener noreferrer' : undefined}
                        class="font-sans text-sm font-bold text-ink underline-offset-4 transition-colors group-hover:text-tomato group-hover:underline"
                      >
                        {shortTitle}
                        {hasExternalDemo && (
                          <span class="ml-1 font-mono text-[11px] font-normal text-ink-soft">↗</span>
                        )}
                      </a>
                      {subTitle && (
                        <p class="truncate text-xs text-ink-soft" title={subTitle}>
                          {subTitle}
                        </p>
                      )}
                    </div>
                  </div>

                  <div class="flex shrink-0 items-center gap-2 pt-0.5 font-mono text-[11px]">
                    <a
                      href={detailHref}
                      class="rounded-sm border border-ink/30 bg-paper-2 px-1.5 py-0.5 text-ink-soft transition-colors hover:border-ink hover:bg-mustard/50 hover:text-ink"
                      title={locale === 'id' ? 'Baca catatan teknis' : 'Read technical notes'}
                    >
                      {locale === 'id' ? 'detail' : 'notes'}
                    </a>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>

  <!-- Info jumlah hasil & Empty State -->
  <div class="mt-4 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-ink-soft">
    <span data-project-result-count>
      {locale === 'id'
        ? `Menampilkan ${allProjects.length} proyek dalam ${orderedGroups.length} kategori`
        : `Showing ${allProjects.length} projects across ${orderedGroups.length} categories`}
    </span>
    <button
      type="button"
      data-project-reset
      class="hidden font-bold text-tomato underline underline-offset-2 hover:text-ink"
    >
      {locale === 'id' ? 'Reset filter' : 'Reset filter'}
    </button>
  </div>

  <div
    data-project-empty
    class="mt-4 hidden rounded-md border-2 border-dashed border-ink/40 bg-paper-2 p-6 text-center"
  >
    <p class="font-display text-base font-bold text-ink">
      {locale === 'id'
        ? 'Tidak ada proyek yang cocok dengan pencarian ini.'
        : 'No projects match this filter.'}
    </p>
    <button
      type="button"
      data-project-reset-empty
      class="sticker-btn bg-mustard text-ink mt-3 rounded-sm px-3.5 py-1.5 font-mono text-xs"
    >
      {locale === 'id' ? 'Tampilkan Semua' : 'Show All'}
    </button>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-project-group]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-project-item]'));
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
    if (items.length === 0 || buttons.length === 0) return;

    const searchInput = document.querySelector<HTMLInputElement>('[data-project-search]');
    const resultCountEl = document.querySelector<HTMLElement>('[data-project-result-count]');
    const resetBtn = document.querySelector<HTMLButtonElement>('[data-project-reset]');
    const resetEmptyBtn = document.querySelector<HTMLButtonElement>('[data-project-reset-empty]');
    const emptyEl = document.querySelector<HTMLElement>('[data-project-empty]');
    const isEn = document.documentElement.lang === 'en';

    let activeCategory = 'all';
    let searchQuery = '';

    const applyFilters = () => {
      const q = searchQuery.trim().toLowerCase();
      const hasActiveFilter = activeCategory !== 'all' || q.length > 0;
      let totalVisible = 0;
      let visibleGroups = 0;

      groups.forEach((groupEl) => {
        const groupKey = groupEl.dataset.projectGroup || '';
        const groupItems = Array.from(groupEl.querySelectorAll<HTMLElement>('[data-project-item]'));
        let groupVisible = 0;

        groupItems.forEach((item) => {
          const cat = item.dataset.category || '';
          const haystack = item.dataset.search || '';
          const match =
            (activeCategory === 'all' || cat === activeCategory) && (!q || haystack.includes(q));
          item.classList.toggle('hidden', !match);
          if (match) {
            groupVisible += 1;
            totalVisible += 1;
          }
        });

        const showGroup =
          (activeCategory === 'all' || groupKey === activeCategory) && groupVisible > 0;
        groupEl.classList.toggle('hidden', !showGroup);
        if (showGroup) visibleGroups += 1;

        const countBadge = groupEl.querySelector<HTMLElement>('[data-group-count]');
        if (countBadge) countBadge.textContent = String(groupVisible);
      });

      emptyEl?.classList.toggle('hidden', totalVisible > 0);
      resetBtn?.classList.toggle('hidden', !hasActiveFilter);

      if (resultCountEl) {
        resultCountEl.textContent = isEn
          ? `Showing ${totalVisible} projects across ${visibleGroups} categories`
          : `Menampilkan ${totalVisible} proyek dalam ${visibleGroups} kategori`;
      }
    };

    const syncCategoryButtons = () => {
      buttons.forEach((btn) => {
        const active = (btn.dataset.projectFilter || 'all') === activeCategory;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.className = active
          ? 'inline-flex items-center gap-1.5 rounded-sm border-2 border-ink bg-ink px-2.5 py-1 font-mono text-xs font-bold text-paper shadow-[2px_2px_0_var(--mustard)] transition-all'
          : 'inline-flex items-center gap-1.5 rounded-sm border-2 border-ink bg-paper px-2.5 py-1 font-mono text-xs font-bold text-ink transition-all hover:bg-mustard/35';
        const badge = btn.querySelector<HTMLElement>('[data-count-badge]');
        if (badge) {
          badge.className = active
            ? 'rounded-sm bg-mustard px-1.5 text-[10px] text-ink'
            : 'rounded-sm bg-paper-2 px-1.5 text-[10px] text-ink-soft';
        }
      });
    };

    const resetAll = () => {
      activeCategory = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      syncCategoryButtons();
      applyFilters();
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.projectFilter || 'all';
        syncCategoryButtons();
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value;
      applyFilters();
    });

    resetBtn?.addEventListener('click', resetAll);
    resetEmptyBtn?.addEventListener('click', resetAll);
  });
</script>
