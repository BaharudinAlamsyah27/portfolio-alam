---
import { Image } from 'astro:assets';
import AudienceSwitcher from '../islands/AudienceSwitcher';
import HandDrawn from '../doodles/HandDrawn.astro';
import RimuruSticker from '../islands/RimuruSticker';
import Tape from '../ui/Tape.astro';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';
import { getProfileData, pickLocale } from '../../lib/content';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const profile = await getProfileData();

const tagline = pickLocale(profile?.tagline, locale) || t('home.title');
---

<section aria-labelledby="hero-heading" class="relative pt-2 pb-6">
  <div class="grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
    <!-- Kolom Kiri (7 kolom): Perkenalan & Audience Switcher -->
    <div class="min-w-0 space-y-6 lg:col-span-7">
      <div class="flex flex-wrap items-center gap-3">
        <div
          class="bg-paper-2 inline-flex items-center gap-2 rounded-sm border-2 border-ink px-3 py-1 font-mono text-xs font-medium shadow-[2px_2px_0_var(--ink)]"
        >
          <span
            class="bg-leaf inline-block h-2.5 w-2.5 rounded-full border border-ink"
            aria-hidden="true"></span>
          <span>{t('status.magang')}</span>
        </div>

        <span class="font-mono text-xs uppercase tracking-wider text-ink-soft">
          {t('home.eyebrow')}
        </span>
      </div>

      <div class="relative">
        <h1
          id="hero-heading"
          class="font-display text-4xl font-extrabold leading-[1.04] tracking-tight sm:text-5xl lg:text-[3.5rem]"
        >
          {tagline}
        </h1>
        <HandDrawn variant="underline" class="text-tomato mt-1 h-4 w-48 sm:w-64" />
      </div>

      <p class="max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
        {t('home.lead')}
      </p>

      <!-- Catatan pinggir tulisan tangan (Kalam) -->
      <div class="flex items-center gap-2 pl-1 text-ink-soft">
        <HandDrawn variant="arrow-curve" class="text-cobalt h-7 w-10 shrink-0 -rotate-12" />
        <p class="font-hand -rotate-1 text-base text-ink sm:text-lg">
          &ldquo;<span data-rough="highlight" data-rough-color="rgba(245, 183, 0, 0.45)">{t('home.marginQuiet')}</span>&rdquo;
        </p>
      </div>

      <!-- Island Interaktif: Audience Switcher -->
      <div class="pt-1">
        <AudienceSwitcher client:load locale={locale} cvUrl={profile?.cvUrl} />
      </div>
    </div>

    <!-- Kolom Kanan (5 kolom): Kartu Meja Kerja & Catatan Tempel -->
    <aside class="relative mt-4 min-w-0 space-y-5 lg:col-span-5 lg:mt-6">
      <!-- Kucing mengintip di atas kartu meja -->
      <div class="flex justify-end pr-6 -mb-6 relative z-20">
        <HandDrawn variant="cat-peek" class="h-11 w-18" />
      </div>

      <div class="sticker-card relative rotate-[1deg] rounded-md bg-paper p-5 sm:p-6">
        <Tape color="mustard" rotate="-rotate-2" class="absolute -top-3 left-1/2 -translate-x-1/2" />

        <div class="flex items-center justify-between border-b-2 border-ink pb-3">
          <div>
            <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-ink-soft">
              {t('home.cardTitle')}
            </span>
            <h2 class="font-display text-xl font-bold">{profile?.name ?? 'Baharudin Alamsyah'}</h2>
          </div>

          <!-- Slot foto asli Alam (bukan avatar AI) -->
          {
            profile?.photo ? (
              <Image
                src={profile.photo}
                alt={profile.name}
                width={64}
                height={64}
                class="h-14 w-14 rounded-sm border-2 border-ink object-cover shadow-[2px_2px_0_var(--ink)]"
              />
            ) : (
              <div
                class="bg-blush text-ink flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-sm border-2 border-ink font-mono text-xs font-bold shadow-[2px_2px_0_var(--ink)]"
                title="Foto asli Alam dapat diunggah lewat Keystatic"
              >
                <span class="text-sm leading-none">BA</span>
                <span class="text-[9px] uppercase opacity-75">FOTO</span>
              </div>
            )
          }
        </div>

        <p class="mt-3 font-mono text-xs font-semibold uppercase tracking-wide text-cobalt">
          {t('home.cardRole')}
        </p>

        <dl class="mt-3 space-y-2.5 text-sm">
          <div class="flex flex-col justify-between gap-0.5 border-b border-dashed border-ink/25 pb-2 sm:flex-row sm:gap-4">
            <dt class="font-mono text-xs font-bold uppercase text-ink-soft">{t('home.fact1Label')}</dt>
            <dd class="font-medium text-ink sm:text-right">{t('home.fact1Val')}</dd>
          </div>
          <div class="flex flex-col justify-between gap-0.5 border-b border-dashed border-ink/25 pb-2 sm:flex-row sm:gap-4">
            <dt class="font-mono text-xs font-bold uppercase text-ink-soft">{t('home.fact2Label')}</dt>
            <dd class="font-medium text-ink sm:text-right">{t('home.fact2Val')}</dd>
          </div>
          <div class="flex flex-col justify-between gap-0.5 border-b border-dashed border-ink/25 pb-2 sm:flex-row sm:gap-4">
            <dt class="font-mono text-xs font-bold uppercase text-ink-soft">{t('home.fact3Label')}</dt>
            <dd class="font-medium text-ink sm:text-right">{t('home.fact3Val')}</dd>
          </div>
          <div class="flex flex-col justify-between gap-0.5 sm:flex-row sm:gap-4">
            <dt class="font-mono text-xs font-bold uppercase text-ink-soft">{t('home.fact4Label')}</dt>
            <dd class="font-medium text-ink sm:text-right">{t('home.fact4Val')}</dd>
          </div>
        </dl>
      </div>

      <!-- Sticky Note kecil (Mustard) + Stiker Rimuru Slime Interaktif (Biru) -->
      <div class="flex flex-wrap items-end justify-end gap-3">
        <RimuruSticker client:idle locale={locale} />

        <div
          class="bg-mustard text-ink relative max-w-xs -rotate-1 rounded-none border-2 border-ink p-3.5 shadow-[4px_4px_0_var(--ink)]"
        >
          <p class="font-hand text-base leading-snug">
            📌 {t('home.stickyNote')}
          </p>
        </div>
      </div>
    </aside>
  </div>
</section>
