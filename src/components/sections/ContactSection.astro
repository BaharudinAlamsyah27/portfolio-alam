---
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';
import { getProfileData } from '../../lib/content';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const profile = await getProfileData();
const socials = profile?.socials ?? [];
---

<section id="contact" aria-labelledby="contact-heading" class="desk-section-contact scroll-mt-20">
  <div class="mb-8 max-w-2xl space-y-2 border-b-2 border-ink pb-4">
    <span class="bg-leaf text-paper inline-block rounded-sm border-2 border-ink px-2 py-0.5 font-mono text-xs font-bold uppercase shadow-[2px_2px_0_var(--ink)]">
      04 · CONTACT
    </span>
    <h2 id="contact-heading" class="font-display text-3xl font-extrabold sm:text-4xl">
      {t('contact.heading')}
    </h2>
    <p class="text-ink-soft text-sm leading-relaxed sm:text-base">
      {t('contact.sub')}
    </p>
  </div>

  <div class="grid gap-7 lg:grid-cols-12">
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="sticker-card space-y-4 rounded-md bg-paper p-6 lg:col-span-7"
    >
      <!-- TODO(alam): isi access_key Web3Forms gratis di variabel PUBLIC_WEB3FORMS_KEY -->
      <input
        type="hidden"
        name="access_key"
        value={import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ''}
      />

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block space-y-1.5 text-sm font-bold text-ink">
          <span>{t('contact.name')}</span>
          <input
            type="text"
            name="name"
            required
            class="bg-paper-2 w-full rounded-sm border-2 border-ink px-3 py-2 text-sm font-normal text-ink"
          />
        </label>

        <label class="block space-y-1.5 text-sm font-bold text-ink">
          <span>{t('contact.email')}</span>
          <input
            type="email"
            name="email"
            required
            class="bg-paper-2 w-full rounded-sm border-2 border-ink px-3 py-2 text-sm font-normal text-ink"
          />
        </label>
      </div>

      <label class="block space-y-1.5 text-sm font-bold text-ink">
        <span>{t('contact.purpose')}</span>
        <select
          name="subject"
          class="bg-paper-2 w-full rounded-sm border-2 border-ink px-3 py-2 text-sm font-normal text-ink"
        >
          <option value="Recruiter">{t('contact.purpose.recruiter')}</option>
          <option value="Klien Freelance">{t('contact.purpose.klien')}</option>
          <option value="Sesama Developer">{t('contact.purpose.dev')}</option>
        </select>
      </label>

      <label class="block space-y-1.5 text-sm font-bold text-ink">
        <span>{t('contact.message')}</span>
        <textarea
          name="message"
          rows={4}
          required
          class="bg-paper-2 w-full rounded-sm border-2 border-ink px-3 py-2 text-sm font-normal text-ink"
        ></textarea>
      </label>

      <button
        type="submit"
        class="sticker-btn bg-tomato text-paper rounded-sm px-5 py-2.5 text-sm"
      >
        <span>{t('contact.send')}</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </form>

    <aside class="sticker-card flex flex-col justify-between rounded-xl bg-paper-2 p-6 lg:col-span-5">
      <div class="space-y-4">
        <h3 class="font-display text-xl font-bold">{t('contact.socialTitle')}</h3>

        {
          socials.length > 0 ? (
            <ul class="flex flex-wrap gap-2.5">
              {socials.map((item) => (
                <li>
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="sticker-btn bg-paper text-ink rounded-sm px-3.5 py-2 font-mono text-xs"
                  >
                    {item.label || item.platform}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="bg-paper rounded-sm border-2 border-dashed border-ink/40 p-4 font-mono text-xs leading-relaxed text-ink-soft">
              {locale === 'id'
                ? 'Daftar sosial media sudah siap diatur lewat panel admin /keystatic → Profil & Sosial Media.'
                : 'Social media links can be added anytime via /keystatic → Profile & Social Media.'}
            </p>
          )
        }
      </div>

      <p class="mt-6 font-hand text-base text-ink-soft">
        &ldquo;{locale === 'id' ? 'Balasan biasanya lebih cepat kalau sambil ngopi pagi.' : 'Replies are usually faster over morning coffee.'}&rdquo;
      </p>
    </aside>
  </div>
</section>
