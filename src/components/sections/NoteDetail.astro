---
import { render, type CollectionEntry } from 'astro:content';
import Tape from '../ui/Tape.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import { pickLocale } from '../../lib/content';

interface Props {
  entry: CollectionEntry<'notes'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const locale = getLocaleFromUrl(Astro.url);
const backHref = getLocalizedPath('/notes', locale);
const summary = pickLocale(entry.data.summary, locale);

const rubricLabels: Record<string, { id: string; en: string; badge: string }> = {
  lab: { id: 'Lab & Kode', en: 'Lab & Code', badge: 'bg-cobalt text-paper' },
  belajar: { id: 'Belajar', en: 'Learning', badge: 'bg-leaf text-paper' },
  event: { id: 'Event & Lomba', en: 'Events', badge: 'bg-tomato text-paper' },
  opini: { id: 'Opini', en: 'Opinion', badge: 'bg-mustard text-ink' },
  jelajah: { id: 'Jalan-jalan', en: 'Travel', badge: 'bg-blush text-ink' },
  hidup: { id: 'Cerita Hidup', en: 'Life Notes', badge: 'bg-paper-2 text-ink' },
};

const catInfo = rubricLabels[entry.data.category] ?? rubricLabels.lab;
const wordCount = (entry.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readMins = Math.max(1, Math.ceil(wordCount / 200));

const dateStr = entry.data.date.toLocaleDateString(locale === 'id' ? 'id-ID' : 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class="mx-auto max-w-3xl space-y-8">
  <a href={backHref} class="sticker-btn bg-paper-2 text-ink rounded-sm px-3.5 py-1.5 font-mono text-xs">
    &larr; {locale === 'id' ? 'Semua catatan' : 'All notes'}
  </a>

  <header class="sticker-card relative rounded-md bg-paper p-6 sm:p-8">
    <Tape color="mustard" rotate="-rotate-1" class="absolute -top-3 left-10" />

    <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-ink-soft">
      <div class="flex flex-wrap items-center gap-2">
        <span class={`rounded-sm border border-ink px-2 py-0.5 text-[11px] font-bold ${catInfo.badge}`}>
          {catInfo[locale]}
        </span>
        <span>{dateStr}</span>
        <span>·</span>
        <span>{readMins} {locale === 'id' ? 'mnt baca' : 'min read'}</span>
      </div>

      <div class="flex flex-wrap gap-1.5">
        {
          entry.data.tags.map((tag) => (
            <span class="bg-paper-2 text-ink rounded-sm border border-ink px-2 py-0.5 text-[11px] font-medium">
              #{tag}
            </span>
          ))
        }
      </div>
    </div>

    <h1 class="font-display mt-3 text-3xl font-extrabold leading-tight sm:text-4xl">
      {entry.data.title}
    </h1>

    <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-lg">{summary}</p>
  </header>

  <div
    class="sticker-card space-y-4 rounded-md bg-paper p-6 leading-relaxed text-ink sm:p-8 [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-bold [&_li]:ml-5 [&_li]:list-disc [&_li]:text-ink-soft [&_ol]:space-y-1.5 [&_ol>li]:list-decimal [&_p]:text-ink-soft [&_p]:leading-relaxed [&_ul]:space-y-1.5"
  >
    <Content />
  </div>
</article>
