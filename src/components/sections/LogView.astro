---
import { render } from 'astro:content';
import { getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import { getChangelogData } from '../../lib/content';

const locale = getLocaleFromUrl(Astro.url);
const entries = await getChangelogData();
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const homeHref = getLocalizedPath('/', locale);
const nowHref = getLocalizedPath('/now', locale);
---

<section class="mx-auto max-w-3xl space-y-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <a href={homeHref} class="sticker-btn bg-paper-2 text-ink rounded-sm px-3.5 py-1.5 font-mono text-xs">
      &larr; {locale === 'id' ? 'Kembali ke meja' : 'Back to desk'}
    </a>

    <a href={nowHref} class="font-mono text-xs font-semibold text-cobalt hover:underline">
      {locale === 'id' ? 'Lihat Halaman /now →' : 'View /now Page →'}
    </a>
  </div>

  <div class="space-y-2 border-b-2 border-ink pb-4">
    <span class="bg-mustard text-ink rounded-sm border-2 border-ink px-2 py-0.5 font-mono text-xs font-bold">
      /LOG · CHANGELOG
    </span>
    <h1 class="font-display text-3xl font-extrabold sm:text-4xl">
      {locale === 'id' ? 'Catatan Perubahan Website' : 'Website Changelog'}
    </h1>
    <p class="text-ink-soft text-sm sm:text-base">
      {locale === 'id'
        ? 'Jejak perkembangan meja kerja digital ini dari waktu ke waktu.'
        : 'A public log of how this digital desk evolves over time.'}
    </p>
  </div>

  <div class="space-y-5">
    {
      rendered.map(({ entry, Content }) => {
        const dateStr = entry.data.date.toLocaleDateString(locale === 'id' ? 'id-ID' : 'en-US', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        });

        return (
          <article class="sticker-card rounded-md bg-paper p-5 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-dashed border-ink/25 pb-3">
              <h2 class="font-display text-xl font-bold">{entry.data.title}</h2>
              <div class="flex items-center gap-2 font-mono text-xs">
                {entry.data.version && (
                  <span class="bg-cobalt text-paper rounded-sm border border-ink px-2 py-0.5 font-bold">
                    v{entry.data.version}
                  </span>
                )}
                <span class="text-ink-soft">{dateStr}</span>
              </div>
            </div>

            <div class="mt-3 text-sm leading-relaxed text-ink-soft [&_p]:leading-relaxed">
              <Content />
            </div>
          </article>
        );
      })
    }
  </div>
</section>
