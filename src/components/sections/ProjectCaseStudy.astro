---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Tape from '../ui/Tape.astro';
import LiveSitePreview from '../islands/LiveSitePreview';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';
import { pickLocale } from '../../lib/content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const backHref = getLocalizedPath('/projects', locale);
const summary = pickLocale(entry.data.summary, locale);
const statusKey = `projects.status.${entry.data.status}` as const;
const hasExternalDemo = /^https?:\/\//i.test(entry.data.demoUrl.trim());
---

<article class="mx-auto max-w-4xl space-y-8">
  <a
    href={backHref}
    class="sticker-btn bg-paper-2 text-ink rounded-sm px-3.5 py-1.5 font-mono text-xs"
  >
    <span aria-hidden="true">&larr;</span>
    <span>{locale === 'id' ? 'Kembali ke daftar project' : 'Back to projects'}</span>
  </a>

  <header class="sticker-card relative rounded-md bg-paper p-6 sm:p-8">
    <Tape color="mustard" rotate="-rotate-1" class="absolute -top-3 left-10" />

    <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
      <span class="bg-tomato text-paper rounded-sm border-2 border-ink px-2 py-0.5 font-bold uppercase">
        {entry.data.category}
      </span>
      <span class="bg-paper-2 text-ink rounded-sm border border-ink px-2 py-0.5">
        {t(statusKey)}
      </span>
    </div>

    <h1 class="font-display mt-3 text-3xl font-extrabold leading-tight sm:text-4xl">
      {entry.data.title}
    </h1>

    {
      entry.data.tagline && (
        <p class="mt-2 font-display text-base font-semibold text-tomato sm:text-lg">
          {entry.data.tagline}
        </p>
      )
    }

    <p class="text-ink-soft mt-3 text-base leading-relaxed sm:text-lg">{summary}</p>

    {
      (entry.data.role || entry.data.context || entry.data.duration) && (
        <dl class="mt-4 grid gap-3 rounded-sm border-2 border-ink bg-paper-2 p-3.5 font-mono text-xs sm:grid-cols-3">
          {entry.data.role && (
            <div>
              <dt class="text-[10px] font-bold uppercase text-ink-soft">
                {locale === 'id' ? 'Peran' : 'Role'}
              </dt>
              <dd class="mt-0.5 font-semibold text-ink">{entry.data.role}</dd>
            </div>
          )}
          {entry.data.context && (
            <div>
              <dt class="text-[10px] font-bold uppercase text-ink-soft">
                {locale === 'id' ? 'Konteks' : 'Context'}
              </dt>
              <dd class="mt-0.5 font-semibold text-ink">{entry.data.context}</dd>
            </div>
          )}
          {entry.data.duration && (
            <div>
              <dt class="text-[10px] font-bold uppercase text-ink-soft">
                {locale === 'id' ? 'Durasi' : 'Duration'}
              </dt>
              <dd class="mt-0.5 font-semibold text-ink">{entry.data.duration}</dd>
            </div>
          )}
        </dl>
      )
    }

    <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t-2 border-dashed border-ink/25 pt-4">
      <ul class="flex flex-wrap gap-1.5" aria-label="Tech stack">
        {
          entry.data.stack.map((tech) => (
            <li class="bg-paper-2 text-ink rounded-sm border border-ink px-2.5 py-0.5 font-mono text-xs font-medium">
              {tech}
            </li>
          ))
        }
      </ul>

      <div class="flex flex-wrap gap-2.5">
        {
          entry.data.demoUrl && (
            <a
              href={entry.data.demoUrl}
              target={hasExternalDemo ? '_blank' : undefined}
              rel={hasExternalDemo ? 'noopener noreferrer' : undefined}
              class="sticker-btn bg-mustard text-ink rounded-sm px-3.5 py-1.5 font-mono text-xs"
            >
              {t('projects.demo')}{hasExternalDemo ? ' ↗' : ''}
            </a>
          )
        }
        {
          entry.data.repoUrl && (
            <a
              href={entry.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="sticker-btn bg-paper text-ink rounded-sm px-3.5 py-1.5 font-mono text-xs"
            >
              {t('projects.repo')}
            </a>
          )
        }
      </div>
    </div>
  </header>

  {
    hasExternalDemo ? (
      <LiveSitePreview
        client:visible
        url={entry.data.demoUrl}
        title={entry.data.title}
        variant="full"
        locale={locale}
        embed={entry.data.embedPreview}
        previewImage={entry.data.previewImage}
      />
    ) : (
      entry.data.cover && (
        <div class="sticker-card overflow-hidden rounded-md bg-paper-2 p-2">
          <Image
            src={entry.data.cover}
            alt={entry.data.title}
            width={1100}
            height={680}
            class="w-full rounded-sm border-2 border-ink object-cover"
          />
        </div>
      )
    )
  }

  <div
    class="sticker-card space-y-4 rounded-md bg-paper p-6 leading-relaxed text-ink sm:p-8 [&_blockquote]:rounded-sm [&_blockquote]:border-l-4 [&_blockquote]:border-mustard [&_blockquote]:bg-paper-2 [&_blockquote]:px-4 [&_blockquote]:py-3 [&_blockquote]:text-sm [&_code]:rounded-sm [&_code]:border [&_code]:border-ink/25 [&_code]:bg-paper-2 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_h2]:mt-6 [&_h2]:mb-2 [&_h2]:border-b-2 [&_h2]:border-ink [&_h2]:pb-1 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-bold [&_h2:first-child]:mt-0 [&_h3]:mt-4 [&_h3]:mb-1.5 [&_h3]:font-display [&_h3]:text-base [&_h3]:font-bold [&_li]:text-ink-soft [&_ol]:ml-5 [&_ol]:list-decimal [&_ol]:space-y-2 [&_p]:leading-relaxed [&_p]:text-ink-soft [&_strong]:font-semibold [&_strong]:text-ink [&_ul]:ml-5 [&_ul]:list-disc [&_ul]:space-y-1.5"
  >
    <Content />

    {
      entry.data.tags.length > 0 && (
        <div class="mt-8 flex flex-wrap items-center gap-1.5 border-t-2 border-dashed border-ink/25 pt-5">
          <span class="mr-1 font-mono text-[11px] font-bold uppercase text-ink-soft">Tags:</span>
          {entry.data.tags.map((tag) => (
            <span class="rounded-sm border border-ink/50 bg-paper-2 px-2 py-0.5 font-mono text-[11px] text-ink">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</article>
