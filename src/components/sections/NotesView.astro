---
import Tape from '../ui/Tape.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import { getNotesData, pickLocale } from '../../lib/content';

const locale = getLocaleFromUrl(Astro.url);
const notes = await getNotesData(false);
const homeHref = getLocalizedPath('/', locale);

const rubricLabels: Record<string, { id: string; en: string; badge: string }> = {
  lab: { id: 'Lab & Kode', en: 'Lab & Code', badge: 'bg-cobalt text-paper' },
  belajar: { id: 'Belajar', en: 'Learning', badge: 'bg-leaf text-paper' },
  event: { id: 'Event & Lomba', en: 'Events', badge: 'bg-tomato text-paper' },
  opini: { id: 'Opini', en: 'Opinion', badge: 'bg-mustard text-ink' },
  jelajah: { id: 'Jalan-jalan', en: 'Travel', badge: 'bg-blush text-ink' },
  hidup: { id: 'Cerita Hidup', en: 'Life Notes', badge: 'bg-paper-2 text-ink' },
};

const activeCategories = ['all', ...Array.from(new Set(notes.map((n) => n.data.category)))];

function estimateReadMins(body?: string): number {
  const words = (body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}
---

<section class="mx-auto max-w-3xl space-y-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <a href={homeHref} class="sticker-btn bg-paper-2 text-ink rounded-sm px-3.5 py-1.5 font-mono text-xs">
      &larr; {locale === 'id' ? 'Kembali ke meja' : 'Back to desk'}
    </a>

    <span class="font-hand text-cobalt -rotate-1 text-base">
      ✎ {locale === 'id' ? 'bisa ditulis & dikelompokkan via /keystatic' : 'editable via /keystatic'}
    </span>
  </div>

  <div class="space-y-2 border-b-2 border-ink pb-4">
    <span class="bg-cobalt text-paper rounded-sm border-2 border-ink px-2 py-0.5 font-mono text-xs font-bold">
      /NOTES · TAMAN CATATAN
    </span>
    <h1 class="font-display text-3xl font-extrabold sm:text-4xl">
      {locale === 'id' ? 'Catatan Lab, Opini & Cerita' : 'Lab Notes, Opinions & Stories'}
    </h1>
    <p class="text-ink-soft text-sm sm:text-base">
      {locale === 'id'
        ? 'Kumpulan catatan pendek dari meja kerja Alam — mulai dari ngulik kode, belajar hal baru, lomba/event, sampai cerita jalan-jalan dan keseharian.'
        : 'Short notes from Alam’s desk — covering code experiments, learning logs, events, travel stories, and daily reflections.'}
    </p>
  </div>

  <!-- Filter Rubrik -->
  <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter rubrik catatan">
    {
      activeCategories.map((cat) => (
        <button
          type="button"
          data-note-filter={cat}
          aria-pressed={cat === 'all' ? 'true' : 'false'}
          class={`rounded-sm border-2 border-ink px-3 py-1 font-mono text-xs font-bold transition-all ${
            cat === 'all'
              ? 'bg-ink text-paper shadow-[2px_2px_0_var(--mustard)]'
              : 'bg-paper text-ink hover:bg-mustard/35'
          }`}
        >
          {cat === 'all'
            ? locale === 'id'
              ? 'Semua'
              : 'All'
            : rubricLabels[cat]?.[locale] ?? cat}
        </button>
      ))
    }
  </div>

  <div class="space-y-6">
    {
      notes.map((entry, idx) => {
        const summary = pickLocale(entry.data.summary, locale);
        const noteHref = getLocalizedPath(`/notes/${entry.id}`, locale);
        const catInfo = rubricLabels[entry.data.category] ?? rubricLabels.lab;
        const mins = estimateReadMins(entry.body);
        const dateStr = entry.data.date.toLocaleDateString(locale === 'id' ? 'id-ID' : 'en-US', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        });

        return (
          <article
            data-note-card
            data-category={entry.data.category}
            class="sticker-card relative rounded-md bg-paper p-6"
          >
            {idx === 0 && <Tape color="mustard" rotate="-rotate-1" class="absolute -top-3 left-8" />}

            <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-ink-soft">
              <div class="flex flex-wrap items-center gap-2">
                <span class={`rounded-sm border border-ink px-2 py-0.5 text-[11px] font-bold ${catInfo.badge}`}>
                  {catInfo[locale]}
                </span>
                <span>{dateStr}</span>
                <span>·</span>
                <span>{mins} {locale === 'id' ? 'mnt baca' : 'min read'}</span>
              </div>

              <div class="flex flex-wrap gap-1.5">
                {entry.data.tags.map((tag) => (
                  <span class="bg-paper-2 text-ink rounded-sm border border-ink px-2 py-0.5 text-[11px] font-medium">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <h2 class="font-display mt-2.5 text-2xl font-extrabold leading-snug">
              <a href={noteHref} class="hover:text-tomato underline-offset-4 hover:underline">
                {entry.data.title}
              </a>
            </h2>

            <p class="mt-2 text-sm leading-relaxed text-ink-soft sm:text-base">{summary}</p>

            <div class="mt-4">
              <a href={noteHref} class="sticker-btn bg-mustard text-ink rounded-sm px-3 py-1.5 font-mono text-xs">
                <span>{locale === 'id' ? 'Baca catatan' : 'Read note'}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-note-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-note-card]');
    if (buttons.length === 0 || cards.length === 0) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const chosen = btn.dataset.noteFilter || 'all';
        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
          b.className = active
            ? 'rounded-sm border-2 border-ink px-3 py-1 font-mono text-xs font-bold transition-all bg-ink text-paper shadow-[2px_2px_0_var(--mustard)]'
            : 'rounded-sm border-2 border-ink px-3 py-1 font-mono text-xs font-bold transition-all bg-paper text-ink hover:bg-mustard/35';
        });

        cards.forEach((card) => {
          const match = chosen === 'all' || card.dataset.category === chosen;
          card.classList.toggle('hidden', !match);
        });
      });
    });
  });
</script>
