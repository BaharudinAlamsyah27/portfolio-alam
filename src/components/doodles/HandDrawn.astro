---
interface Props {
  variant: 'underline' | 'arrow-curve' | 'cat-peek' | 'Loop';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;
---

{
  variant === 'underline' && (
    <svg
      viewBox="0 0 220 16"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={`pointer-events-none select-none ${className}`}
      aria-hidden="true"
    >
      <path
        d="M3 11.5C48 5.2 104 4.8 217 9.2C162 12.5 85 12.8 18 13.8"
        stroke="currentColor"
        stroke-width="3.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}

{
  variant === 'arrow-curve' && (
    <svg
      viewBox="0 0 68 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={`pointer-events-none select-none ${className}`}
      aria-hidden="true"
    >
      <path
        d="M62 6C42 7 20 16 11 38M11 38L6 26M11 38L23 34"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}

{
  variant === 'cat-peek' && (
    <svg
      viewBox="0 0 72 44"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={`select-none ${className}`}
      role="img"
      aria-label="Kucing meja kerja"
    >
      <!-- Telinga & kepala kucing bergaya coretan tinta -->
      <path
        d="M14 38V18L24 26H48L58 18V38"
        fill="var(--ink)"
        stroke="var(--ink)"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
      <!-- Dalam telinga blush -->
      <path d="M17 23L21 26H17V23Z" fill="var(--blush)" />
      <path d="M55 23L51 26H55V23Z" fill="var(--blush)" />
      <!-- Mata kuning mustard -->
      <circle cx="28" cy="32" r="2.6" fill="var(--mustard)" />
      <circle cx="44" cy="32" r="2.6" fill="var(--mustard)" />
      <!-- Hidung kecil -->
      <path d="M35 34.5H37L36 36L35 34.5Z" fill="var(--blush)" />
      <!-- Kumis kiri & kanan -->
      <path
        d="M8 31H15M7 35H15M57 31H64M57 35H65"
        stroke="var(--ink)"
        stroke-width="2"
        stroke-linecap="round"
      />
      <!-- Cakar mengintip di garis meja -->
      <ellipse cx="22" cy="39" rx="4.5" ry="2.5" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
      <ellipse cx="50" cy="39" rx="4.5" ry="2.5" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
    </svg>
  )
}
