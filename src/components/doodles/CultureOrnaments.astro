---
interface Props {
  variant: 'batik-ribbon' | 'gunungan';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;
---

{
  variant === 'batik-ribbon' && (
    <div
      class={`h-3.5 w-full overflow-hidden rounded-t-[4px] border-b-2 border-ink bg-paper-2 ${className}`}
      aria-hidden="true"
      title="Motif Batik Kawung"
    >
      <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="kawung-tile" width="24" height="14" patternUnits="userSpaceOnUse">
            <ellipse cx="6" cy="3.5" rx="4.5" ry="2.4" fill="var(--mustard)" fill-opacity="0.55" stroke="var(--ink)" stroke-width="0.9" />
            <ellipse cx="18" cy="3.5" rx="4.5" ry="2.4" fill="var(--slime)" fill-opacity="0.45" stroke="var(--ink)" stroke-width="0.9" />
            <ellipse cx="6" cy="10.5" rx="4.5" ry="2.4" fill="var(--slime)" fill-opacity="0.45" stroke="var(--ink)" stroke-width="0.9" />
            <ellipse cx="18" cy="10.5" rx="4.5" ry="2.4" fill="var(--mustard)" fill-opacity="0.55" stroke="var(--ink)" stroke-width="0.9" />
            <circle cx="12" cy="7" r="1.6" fill="var(--ink)" />
            <circle cx="0" cy="7" r="1.3" fill="var(--ink)" />
            <circle cx="24" cy="7" r="1.3" fill="var(--ink)" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#kawung-tile)" />
      </svg>
    </div>
  )
}

{
  variant === 'gunungan' && (
    <svg
      viewBox="0 0 64 80"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={`select-none ${className}`}
      role="img"
      aria-label="Ornamen Gunungan Wayang"
    >
      {/* Siluet Gunungan Wayang bergaya cap stempel tinta */}
      <path
        d="M32 4C43 18 54 32 56 54C56.5 60 53 66 47 68H17C11 66 7.5 60 8 54C10 32 21 18 32 4Z"
        fill="var(--mustard)"
        fill-opacity="0.28"
        stroke="var(--ink)"
        stroke-width="2.2"
        stroke-linejoin="round"
      />
      {/* Pohon hayat / sumbu tengah */}
      <path d="M32 14V68" stroke="var(--ink)" stroke-width="1.8" stroke-linecap="round" />
      {/* Sulur & cabang simetris */}
      <path
        d="M32 26C25 27 21 32 18 38M32 26C39 27 43 32 46 38M32 40C24 41 19 46 16 53M32 40C40 41 45 46 48 53"
        stroke="var(--ink)"
        stroke-width="1.6"
        stroke-linecap="round"
      />
      {/* Gerbang kecil di dasar gunungan */}
      <path
        d="M25 68V56H39V68"
        fill="var(--slime-soft)"
        stroke="var(--ink)"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
      {/* Tangkai gapit */}
      <path d="M32 68V77" stroke="var(--ink)" stroke-width="2.6" stroke-linecap="round" />
    </svg>
  )
}
