---
/**
 * Partikel Geometris & Bintang Hidup ala Web Resmi Tensura (ten-sura.com):
 * - Kotak piksel biru tunggal, gugusan 2-3 kotak diagonal, kotak outline tipis, bintang kelap-kelip, & tanda (+)
 * - Terus melayang naik-turun, berputar pelan, & berkelap-kelip walau layar sedang diam
 * - Aktif di semua tema (Krem, Rimuru, Malam), 100% CSS GPU (0 KB JS).
 */

interface FloatItem {
  kind: 'pixel' | 'cluster' | 'outline' | 'plus' | 'star';
  top: string;
  left: string;
  size?: number;
  w?: number;
  h?: number;
  color?: string;
  dur: string;
  delay: string;
  anim: 'float-a' | 'float-b' | 'float-c' | 'pulse-rot' | 'twinkle';
}

const shapes: FloatItem[] = [
  // Gugusan kotak piksel diagonal
  { kind: 'cluster', top: '14%', left: '14%', color: 'var(--slime)', dur: '4.6s', delay: '0s', anim: 'float-a' },
  { kind: 'cluster', top: '26%', left: '84%', color: 'var(--slime-deep)', dur: '5.2s', delay: '0.8s', anim: 'float-b' },
  { kind: 'cluster', top: '58%', left: '12%', color: 'var(--slime-deep)', dur: '5.5s', delay: '0.4s', anim: 'float-c' },
  { kind: 'cluster', top: '68%', left: '86%', color: 'var(--slime)', dur: '4.9s', delay: '1.2s', anim: 'float-a' },
  { kind: 'cluster', top: '86%', left: '48%', color: 'var(--slime)', dur: '5.4s', delay: '0.9s', anim: 'float-b' },

  // Kotak outline tipis berongga
  { kind: 'outline', top: '19%', left: '76%', w: 28, h: 18, color: 'var(--slime-deep)', dur: '5.8s', delay: '0.2s', anim: 'float-b' },
  { kind: 'outline', top: '38%', left: '16%', w: 24, h: 16, color: 'var(--ink)', dur: '5.2s', delay: '1.1s', anim: 'float-c' },
  { kind: 'outline', top: '48%', left: '82%', w: 22, h: 22, color: 'var(--slime)', dur: '6.0s', delay: '0.6s', anim: 'float-a' },
  { kind: 'outline', top: '78%', left: '15%', w: 30, h: 18, color: 'var(--slime-deep)', dur: '5.6s', delay: '1.4s', anim: 'float-b' },
  { kind: 'outline', top: '84%', left: '78%', w: 20, h: 14, color: 'var(--mustard)', dur: '5.0s', delay: '0.7s', anim: 'float-c' },

  // Kotak piksel tunggal melayang
  { kind: 'pixel', top: '11%', left: '42%', size: 9, color: 'var(--slime)', dur: '4.4s', delay: '0.3s', anim: 'float-c' },
  { kind: 'pixel', top: '32%', left: '54%', size: 8, color: 'var(--mustard)', dur: '4.8s', delay: '1.0s', anim: 'float-a' },
  { kind: 'pixel', top: '44%', left: '28%', size: 10, color: 'var(--slime)', dur: '5.1s', delay: '1.3s', anim: 'float-b' },
  { kind: 'pixel', top: '62%', left: '66%', size: 9, color: 'var(--slime-deep)', dur: '4.5s', delay: '0.5s', anim: 'float-a' },
  { kind: 'pixel', top: '74%', left: '36%', size: 8, color: 'var(--slime)', dur: '4.9s', delay: '0.9s', anim: 'float-c' },
  { kind: 'pixel', top: '90%', left: '24%', size: 10, color: 'var(--mustard)', dur: '5.3s', delay: '0.4s', anim: 'float-b' },

  // Bintang kelap-kelip 4-sudut
  { kind: 'star', top: '16%', left: '62%', size: 14, color: 'var(--mustard)', dur: '2.8s', delay: '0.1s', anim: 'twinkle' },
  { kind: 'star', top: '28%', left: '21%', size: 12, color: 'var(--slime-deep)', dur: '3.2s', delay: '0.9s', anim: 'twinkle' },
  { kind: 'star', top: '52%', left: '73%', size: 15, color: 'var(--mustard)', dur: '2.6s', delay: '0.5s', anim: 'twinkle' },
  { kind: 'star', top: '71%', left: '19%', size: 13, color: 'var(--slime)', dur: '3.0s', delay: '1.4s', anim: 'twinkle' },
  { kind: 'star', top: '87%', left: '68%', size: 14, color: 'var(--mustard)', dur: '2.9s', delay: '0.7s', anim: 'twinkle' },

  // Tanda (+) grid teknis mungil
  { kind: 'plus', top: '22%', left: '30%', color: 'var(--slime-deep)', dur: '4.2s', delay: '0.2s', anim: 'pulse-rot' },
  { kind: 'plus', top: '36%', left: '70%', color: 'var(--slime-deep)', dur: '4.8s', delay: '1.1s', anim: 'pulse-rot' },
  { kind: 'plus', top: '64%', left: '24%', color: 'var(--slime-deep)', dur: '5.0s', delay: '0.6s', anim: 'pulse-rot' },
  { kind: 'plus', top: '80%', left: '62%', color: 'var(--slime-deep)', dur: '4.5s', delay: '1.3s', anim: 'pulse-rot' },
];
---

<div
  class="pointer-events-none fixed inset-0 z-[1] overflow-hidden select-none"
  aria-hidden="true"
>
  {
    shapes.map((s) => {
      const styleBase = `top:${s.top};left:${s.left};--t-dur:${s.dur};--t-delay:${s.delay};`;

      if (s.kind === 'pixel') {
        return (
          <span
            class={`tensura-shape tensura-${s.anim} absolute rounded-[1px]`}
            style={`${styleBase}width:${s.size ?? 9}px;height:${s.size ?? 9}px;background:${s.color};opacity:0.8;`}
          />
        );
      }

      if (s.kind === 'outline') {
        return (
          <span
            class={`tensura-shape tensura-${s.anim} absolute rounded-[2px] border-2`}
            style={`${styleBase}width:${s.w}px;height:${s.h}px;border-color:${s.color};opacity:0.5;`}
          />
        );
      }

      if (s.kind === 'star') {
        return (
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class={`tensura-shape tensura-${s.anim} absolute`}
            style={`${styleBase}width:${s.size ?? 14}px;height:${s.size ?? 14}px;`}
          >
            <path
              d="M10 1L12.1 7.9L19 10L12.1 12.1L10 19L7.9 12.1L1 10L7.9 7.9L10 1Z"
              fill={s.color}
              stroke="var(--ink)"
              stroke-width="1.1"
            />
          </svg>
        );
      }

      if (s.kind === 'cluster') {
        return (
          <span class={`tensura-shape tensura-${s.anim} absolute block h-7 w-7`} style={styleBase}>
            <span
              class="absolute top-0 left-3 h-2.5 w-2.5 rounded-[1px]"
              style={`background:${s.color};opacity:0.85;`}
            />
            <span
              class="absolute top-3 left-0 h-2.5 w-2.5 rounded-[1px]"
              style={`background:${s.color};opacity:0.6;`}
            />
            <span
              class="absolute top-3.5 left-4 h-2 w-2 rounded-[1px]"
              style={`background:var(--mustard);opacity:0.8;`}
            />
          </span>
        );
      }

      return (
        <span
          class={`tensura-shape tensura-${s.anim} absolute font-mono text-sm font-bold leading-none`}
          style={`${styleBase}color:${s.color};opacity:0.55;`}
        >
          +
        </span>
      );
    })
  }
</div>
