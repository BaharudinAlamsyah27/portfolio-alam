---
/**
 * Pernik & Objek Visual Khas per Halaman (0 KB JS, 100% SVG + CSS GPU):
 * Membuat halaman Catatan, Toko, Arsip Proyek, dan Now/Log punya "jiwa" ruang tersendiri
 * tanpa mengganggu keterbacaan konten utama (berada di tepi/margin aman).
 */
interface Props {
  pageKind: 'notes' | 'toko' | 'projects' | 'logbook';
}

const { pageKind } = Astro.props;
---

<div
  class="pointer-events-none fixed inset-0 z-[1] overflow-hidden select-none"
  aria-hidden="true"
>
  {
    pageKind === 'notes' && (
      <>
        {/* Kiri atas: Penjepit Kertas (Paperclip) */}
        <svg
          viewBox="0 0 64 96"
          fill="none"
          class="tensura-shape tensura-float-a absolute top-[18%] left-[9%] hidden h-16 w-11 opacity-70 lg:block"
          style="--t-dur:6.2s;--t-delay:0s;"
        >
          <path
            d="M22 24v44c0 10 8 18 18 18s18-8 18-18V20c0-7.5-6-13.5-13.5-13.5S31 12.5 31 20v42c0 4 3.2 7.2 7.2 7.2s7.2-3.2 7.2-7.2V26"
            stroke="var(--ink)"
            stroke-width="4.5"
            stroke-linecap="round"
          />
          <path
            d="M22 24v44c0 10 8 18 18 18s18-8 18-18V20c0-7.5-6-13.5-13.5-13.5S31 12.5 31 20v42c0 4 3.2 7.2 7.2 7.2s7.2-3.2 7.2-7.2V26"
            stroke="var(--cobalt)"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>

        {/* Kanan atas: Pena / Bolpoin Tinta */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-float-b absolute top-[20%] right-[9%] hidden h-16 w-16 opacity-80 lg:block"
          style="--t-dur:5.4s;--t-delay:0.4s;"
        >
          <g transform="rotate(-24 40 40)">
            <rect x="31" y="10" width="18" height="44" rx="3" fill="var(--mustard)" stroke="var(--ink)" stroke-width="2.5" />
            <rect x="31" y="10" width="18" height="10" rx="2" fill="var(--tomato)" stroke="var(--ink)" stroke-width="2.5" />
            <polygon points="31,54 49,54 40,70" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" />
            <polygon points="37,64 43,64 40,70" fill="var(--ink)" />
          </g>
        </svg>

        {/* Kiri bawah: Cangkir Kopi Hangat */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-float-c absolute bottom-[16%] left-[10%] hidden h-16 w-16 opacity-75 lg:block"
          style="--t-dur:6.4s;--t-delay:0.8s;"
        >
          <path d="M26 22c-3-4 3-8 0-12M38 20c-3-4 3-8 0-12M50 22c-3-4 3-8 0-12" stroke="var(--ink-soft)" stroke-width="2" stroke-linecap="round" />
          <path d="M18 30h40v22c0 10-9 18-20 18s-20-8-20-18V30z" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" />
          <path d="M58 34h6c5 0 8 4 8 8.5S69 51 64 51h-6" stroke="var(--ink)" stroke-width="2.5" />
          <ellipse cx="38" cy="30" rx="20" ry="4" fill="var(--ink-soft)" opacity="0.35" />
          <rect x="14" y="70" width="48" height="4" rx="2" fill="var(--ink)" />
        </svg>

        {/* Kanan bawah: Sticky Note Mini */}
        <svg
          viewBox="0 0 84 84"
          fill="none"
          class="tensura-shape tensura-float-a absolute right-[9%] bottom-[18%] hidden h-16 w-16 opacity-80 lg:block"
          style="--t-dur:5.8s;--t-delay:1s;"
        >
          <g transform="rotate(6 42 42)">
            <rect x="14" y="16" width="56" height="56" rx="3" fill="var(--ink)" opacity="0.2" transform="translate(4 4)" />
            <rect x="14" y="16" width="56" height="56" rx="3" fill="var(--mustard)" stroke="var(--ink)" stroke-width="2.5" />
            <rect x="29" y="10" width="26" height="10" fill="var(--blush)" stroke="var(--ink)" stroke-width="1.8" />
            <line x1="23" y1="34" x2="61" y2="34" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
            <line x1="23" y1="45" x2="54" y2="45" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
            <line x1="23" y1="56" x2="46" y2="56" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
          </g>
        </svg>
      </>
    )
  }

  {
    pageKind === 'toko' && (
      <>
        {/* Kiri atas: Stempel READY / INDIE */}
        <svg
          viewBox="0 0 96 64"
          fill="none"
          class="tensura-shape tensura-float-b absolute top-[18%] left-[9%] hidden h-14 w-20 opacity-75 lg:block"
          style="--t-dur:5.6s;--t-delay:0s;"
        >
          <g transform="rotate(-10 48 32)">
            <rect x="6" y="12" width="84" height="40" rx="6" fill="var(--paper)" stroke="var(--leaf)" stroke-width="3" />
            <rect x="11" y="17" width="74" height="30" rx="3" stroke="var(--leaf)" stroke-width="1.5" stroke-dasharray="4 3" />
            <text x="48" y="37" text-anchor="middle" font-family="monospace" font-size="13" font-weight="900" fill="var(--leaf)">READY!</text>
          </g>
        </svg>

        {/* Kanan atas: Price Tag Gantung */}
        <svg
          viewBox="0 0 80 88"
          fill="none"
          class="tensura-shape tensura-float-a absolute top-[20%] right-[9%] hidden h-16 w-16 opacity-80 lg:block"
          style="--t-dur:5.2s;--t-delay:0.4s;"
        >
          <g transform="rotate(12 40 44)">
            <path d="M22 14h36l10 14v44c0 3-2 5-5 5H17c-3 0-5-2-5-5V28l10-14z" fill="var(--tomato)" stroke="var(--ink)" stroke-width="2.5" />
            <circle cx="40" cy="25" r="4.5" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
            <text x="40" y="54" text-anchor="middle" font-family="monospace" font-size="14" font-weight="900" fill="var(--paper)">PRO</text>
          </g>
        </svg>

        {/* Kiri bawah: Kotak Paket / Kardus */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-float-c absolute bottom-[16%] left-[10%] hidden h-16 w-16 opacity-75 lg:block"
          style="--t-dur:6.1s;--t-delay:0.7s;"
        >
          <rect x="14" y="24" width="52" height="44" rx="4" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="2.5" />
          <path d="M14 34h52" stroke="var(--ink)" stroke-width="2.5" />
          <rect x="33" y="24" width="14" height="18" fill="var(--mustard)" stroke="var(--ink)" stroke-width="2" />
          <line x1="22" y1="54" x2="36" y2="54" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
        </svg>

        {/* Kanan bawah: Koin Emas Berkilau */}
        <svg
          viewBox="0 0 72 72"
          fill="none"
          class="tensura-shape tensura-float-b absolute right-[10%] bottom-[18%] hidden h-14 w-14 opacity-80 lg:block"
          style="--t-dur:4.9s;--t-delay:1.1s;"
        >
          <circle cx="36" cy="36" r="24" fill="var(--mustard)" stroke="var(--ink)" stroke-width="2.5" />
          <circle cx="36" cy="36" r="17" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="4 3" />
          <text x="36" y="42" text-anchor="middle" font-family="monospace" font-size="15" font-weight="900" fill="var(--ink)">Rp</text>
        </svg>
      </>
    )
  }

  {
    pageKind === 'projects' && (
      <>
        {/* Kiri atas: Kurung Kurawal Kode { } */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-float-a absolute top-[18%] left-[9%] hidden h-16 w-16 opacity-75 lg:block"
          style="--t-dur:5.5s;--t-delay:0s;"
        >
          <rect x="10" y="14" width="60" height="52" rx="6" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" />
          <text x="40" y="48" text-anchor="middle" font-family="monospace" font-size="24" font-weight="900" fill="var(--cobalt)">&#123; / &#125;</text>
        </svg>

        {/* Kanan atas: Roda Gigi Engineering (Gear) */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-pulse-rot absolute top-[19%] right-[9%] hidden h-16 w-16 opacity-75 lg:block"
          style="--t-dur:10s;--t-delay:0.2s;"
        >
          <path
            d="M36 10h8l2 8a22 22 0 016 2.5l7-4.2 5.6 5.6-4.2 7a22 22 0 012.5 6l8 2v8l-8 2a22 22 0 01-2.5 6l4.2 7-5.6 5.6-7-4.2a22 22 0 01-6 2.5l-2 8h-8l-2-8a22 22 0 01-6-2.5l-7 4.2-5.6-5.6 4.2-7a22 22 0 01-2.5-6l-8-2v-8l8-2a22 22 0 012.5-6l-4.2-7 5.6-5.6 7 4.2a22 22 0 016-2.5l2-8z"
            fill="var(--slime-soft)"
            stroke="var(--ink)"
            stroke-width="2.5"
          />
          <circle cx="40" cy="40" r="10" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" />
        </svg>

        {/* Kiri bawah: Mini Server Rack + Lampu LED */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-float-c absolute bottom-[16%] left-[10%] hidden h-16 w-16 opacity-75 lg:block"
          style="--t-dur:6.0s;--t-delay:0.6s;"
        >
          <rect x="14" y="14" width="52" height="22" rx="3" fill="var(--ink)" stroke="var(--ink)" stroke-width="2" />
          <circle cx="24" cy="25" r="3" fill="var(--leaf)" />
          <line x1="34" y1="25" x2="56" y2="25" stroke="var(--paper)" stroke-width="2" stroke-linecap="round" />
          <rect x="14" y="44" width="52" height="22" rx="3" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" />
          <circle cx="24" cy="55" r="3" fill="var(--tomato)" />
          <line x1="34" y1="55" x2="56" y2="55" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
        </svg>

        {/* Kanan bawah: Penggaris Siku */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-float-b absolute right-[9%] bottom-[18%] hidden h-16 w-16 opacity-75 lg:block"
          style="--t-dur:5.4s;--t-delay:0.9s;"
        >
          <path d="M16 14v52h52L16 14z" fill="var(--mustard)" stroke="var(--ink)" stroke-width="2.5" />
          <path d="M26 36v20h20L26 36z" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
        </svg>
      </>
    )
  }

  {
    pageKind === 'logbook' && (
      <>
        {/* Kiri atas: Badge Checklist */}
        <svg
          viewBox="0 0 84 60"
          fill="none"
          class="tensura-shape tensura-float-a absolute top-[18%] left-[9%] hidden h-14 w-20 opacity-75 lg:block"
          style="--t-dur:5.4s;--t-delay:0s;"
        >
          <rect x="6" y="10" width="72" height="40" rx="5" fill="var(--leaf)" stroke="var(--ink)" stroke-width="2.5" />
          <path d="M20 31l7 7 15-15" stroke="var(--paper)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
          <text x="56" y="35" text-anchor="middle" font-family="monospace" font-size="11" font-weight="900" fill="var(--paper)">LOG</text>
        </svg>

        {/* Kanan atas: Jam / Stopwatch */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-float-b absolute top-[19%] right-[9%] hidden h-16 w-16 opacity-80 lg:block"
          style="--t-dur:5.0s;--t-delay:0.3s;"
        >
          <rect x="34" y="8" width="12" height="8" rx="2" fill="var(--tomato)" stroke="var(--ink)" stroke-width="2" />
          <circle cx="40" cy="44" r="24" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" />
          <circle cx="40" cy="44" r="18" stroke="var(--ink-soft)" stroke-width="1.2" stroke-dasharray="3 3" />
          <path d="M40 31v13l9 6" stroke="var(--tomato)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>

        {/* Kiri bawah: Kalender Mini */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-float-c absolute bottom-[16%] left-[10%] hidden h-16 w-16 opacity-75 lg:block"
          style="--t-dur:5.9s;--t-delay:0.7s;"
        >
          <rect x="14" y="16" width="52" height="50" rx="5" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" />
          <path d="M14 28h52" stroke="var(--ink)" stroke-width="2.5" />
          <rect x="14" y="16" width="52" height="12" rx="4" fill="var(--cobalt)" stroke="var(--ink)" stroke-width="2.5" />
          <text x="40" y="54" text-anchor="middle" font-family="monospace" font-size="16" font-weight="900" fill="var(--ink)">NOW</text>
        </svg>

        {/* Kanan bawah: Kompas */}
        <svg
          viewBox="0 0 80 80"
          fill="none"
          class="tensura-shape tensura-float-a absolute right-[9%] bottom-[18%] hidden h-16 w-16 opacity-75 lg:block"
          style="--t-dur:5.6s;--t-delay:1s;"
        >
          <circle cx="40" cy="40" r="24" fill="var(--mustard)" stroke="var(--ink)" stroke-width="2.5" />
          <polygon points="40,20 46,40 40,36 34,40" fill="var(--tomato)" stroke="var(--ink)" stroke-width="1.5" />
          <polygon points="40,60 46,40 40,44 34,40" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        </svg>
      </>
    )
  }
</div>
