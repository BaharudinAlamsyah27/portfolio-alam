---
/**
 * 5 Ornamen Bergerak Koleksi Pribadi Alam:
 * - train-track : Kereta api (lokomotif + 2 gerbong + asap) melaju mulus di rel
 * - flag-id     : Bendera Merah Putih berkibar lembut
 * - rocket      : Roket meluncur dengan api pendorong berkedip
 * - chip        : Chip semikonduktor IC dengan sinyal inti berdenyut
 * - gundam      : Kepala Gundam (V-Fin emas) dengan mata berpendar pelan
 * 100% SVG + CSS GPU (0 KB JS).
 */
interface Props {
  variant: 'train-track' | 'flag-id' | 'rocket' | 'chip' | 'gundam';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;
---

{
  variant === 'train-track' && (
    <div
      class={`relative h-12 w-full overflow-hidden border-t-2 border-ink/25 bg-paper-2/50 select-none ${className}`}
      aria-hidden="true"
      title="Kereta Api · Brebes ↔ Sragen"
    >
      {/* Rel kereta api & bantalan */}
      <div class="absolute right-0 bottom-2 left-0 h-1 border-y border-ink/50 bg-paper"></div>
      <div
        class="absolute right-0 bottom-0.5 left-0 h-1.5 opacity-45"
        style="background-image: repeating-linear-gradient(90deg, var(--ink) 0px, var(--ink) 4px, transparent 4px, transparent 14px);"
      ></div>

      {/* Kereta melaju dari kiri ke kanan */}
      <div class="train-runner absolute bottom-2.5 left-0 flex items-end gap-1">
        {/* Gerbong 2 */}
        <svg viewBox="0 0 64 28" fill="none" class="h-6 w-14 shrink-0">
          <rect x="2" y="4" width="60" height="18" rx="3" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
          <rect x="2" y="14" width="60" height="4" fill="var(--slime)" />
          <rect x="8" y="8" width="9" height="5" rx="1" fill="var(--slime-soft)" stroke="var(--ink)" stroke-width="1.3" />
          <rect x="21" y="8" width="9" height="5" rx="1" fill="var(--slime-soft)" stroke="var(--ink)" stroke-width="1.3" />
          <rect x="34" y="8" width="9" height="5" rx="1" fill="var(--slime-soft)" stroke="var(--ink)" stroke-width="1.3" />
          <rect x="47" y="8" width="9" height="5" rx="1" fill="var(--slime-soft)" stroke="var(--ink)" stroke-width="1.3" />
          <circle cx="14" cy="24" r="3" fill="var(--ink)" />
          <circle cx="50" cy="24" r="3" fill="var(--ink)" />
        </svg>

        {/* Sambungan */}
        <span class="mb-2 h-1 w-1.5 bg-ink"></span>

        {/* Gerbong 1 */}
        <svg viewBox="0 0 64 28" fill="none" class="h-6 w-14 shrink-0">
          <rect x="2" y="4" width="60" height="18" rx="3" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
          <rect x="2" y="14" width="60" height="4" fill="var(--tomato)" />
          <rect x="8" y="8" width="9" height="5" rx="1" fill="var(--mustard)" fill-opacity="0.5" stroke="var(--ink)" stroke-width="1.3" />
          <rect x="21" y="8" width="9" height="5" rx="1" fill="var(--mustard)" fill-opacity="0.5" stroke="var(--ink)" stroke-width="1.3" />
          <rect x="34" y="8" width="9" height="5" rx="1" fill="var(--mustard)" fill-opacity="0.5" stroke="var(--ink)" stroke-width="1.3" />
          <rect x="47" y="8" width="9" height="5" rx="1" fill="var(--mustard)" fill-opacity="0.5" stroke="var(--ink)" stroke-width="1.3" />
          <circle cx="14" cy="24" r="3" fill="var(--ink)" />
          <circle cx="50" cy="24" r="3" fill="var(--ink)" />
        </svg>

        {/* Sambungan */}
        <span class="mb-2 h-1 w-1.5 bg-ink"></span>

        {/* Lokomotif Ekspres + Asap */}
        <svg viewBox="0 0 82 34" fill="none" class="h-7.5 w-18 shrink-0">
          {/* Kepulan asap melayang */}
          <circle cx="52" cy="6" r="3.5" fill="var(--ink-soft)" fill-opacity="0.35" class="train-smoke" />
          <circle cx="43" cy="4" r="2.6" fill="var(--ink-soft)" fill-opacity="0.25" class="train-smoke" style="animation-delay:0.4s;" />
          {/* Cerobong */}
          <rect x="54" y="7" width="6" height="6" rx="1" fill="var(--ink)" />
          {/* Badan Lokomotif */}
          <path
            d="M4 12H58C68 12 76 18 78 26V28H4V12Z"
            fill="var(--cobalt)"
            stroke="var(--ink)"
            stroke-width="2"
            stroke-linejoin="round"
          />
          {/* Garis oranye-kuning khas lokomotif Indonesia */}
          <path d="M4 21H76" stroke="var(--mustard)" stroke-width="3" />
          <path d="M4 24.5H77" stroke="var(--tomato)" stroke-width="2" />
          {/* Kaca masinis */}
          <path d="M52 14.5H62L66 19.5H52V14.5Z" fill="var(--slime-soft)" stroke="var(--ink)" stroke-width="1.4" />
          {/* Lampu depan menyala */}
          <circle cx="77" cy="23" r="2.2" fill="var(--mustard)" />
          {/* Roda */}
          <circle cx="16" cy="30" r="3.2" fill="var(--ink)" />
          <circle cx="34" cy="30" r="3.2" fill="var(--ink)" />
          <circle cx="62" cy="30" r="3.2" fill="var(--ink)" />
        </svg>
      </div>
    </div>
  )
}

{
  variant === 'flag-id' && (
    <span
      class={`inline-flex items-center gap-1 select-none ${className}`}
      title="Indonesia"
      aria-label="Bendera Indonesia"
    >
      <svg viewBox="0 0 36 28" fill="none" class="h-5 w-6.5 overflow-visible">
        {/* Tiang bendera */}
        <line x1="4" y1="3" x2="4" y2="26" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" />
        <circle cx="4" cy="3" r="2" fill="var(--mustard)" stroke="var(--ink)" stroke-width="1.2" />
        {/* Kain Merah Putih berkibar */}
        <g class="flag-wave-group">
          <path
            d="M6 5C12 3.5 19 6.5 28 5V12C19 13.5 12 10.5 6 12V5Z"
            fill="#e53935"
            stroke="var(--ink)"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
          <path
            d="M6 12C12 10.5 19 13.5 28 12V19C19 20.5 12 17.5 6 19V12Z"
            fill="#ffffff"
            stroke="var(--ink)"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
        </g>
      </svg>
    </span>
  )
}

{
  variant === 'rocket' && (
    <div class={`rocket-hover inline-flex select-none ${className}`} aria-hidden="true" title="Launch Projects">
      <svg viewBox="0 0 56 64" fill="none" class="h-12 w-11">
        {/* Api pendorong berkedip */}
        <path
          d="M23 48L28 61L33 48Z"
          fill="var(--tomato)"
          stroke="var(--ink)"
          stroke-width="1.5"
          stroke-linejoin="round"
          class="rocket-flame"
        />
        <path d="M25.5 48L28 56L30.5 48Z" fill="var(--mustard)" class="rocket-flame" />
        {/* Sayap kiri & kanan */}
        <path d="M18 35L9 45H18V35Z" fill="var(--tomato)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round" />
        <path d="M38 35L47 45H38V35Z" fill="var(--tomato)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round" />
        {/* Badan roket */}
        <path
          d="M28 5C21 13 18 24 18 46H38C38 24 35 13 28 5Z"
          fill="var(--paper)"
          stroke="var(--ink)"
          stroke-width="2.2"
          stroke-linejoin="round"
        />
        {/* Hidung merah */}
        <path d="M28 5C24.5 9.5 22.3 14 21 18H35C33.7 14 31.5 9.5 28 5Z" fill="var(--tomato)" stroke="var(--ink)" stroke-width="1.8" />
        {/* Jendela biru slime */}
        <circle cx="28" cy="28" r="5" fill="var(--slime)" stroke="var(--ink)" stroke-width="2" />
        <circle cx="26.5" cy="26.5" r="1.4" fill="var(--paper)" />
        {/* Nozzle */}
        <rect x="22" y="46" width="12" height="3.5" rx="1" fill="var(--ink)" />
      </svg>
    </div>
  )
}

{
  variant === 'chip' && (
    <div class={`inline-flex select-none ${className}`} aria-hidden="true" title="Semiconductor IC">
      <svg viewBox="0 0 64 64" fill="none" class="h-12 w-12">
        {/* Pin kaki-kaki semikonduktor */}
        <g stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round">
          <path d="M20 6V14M28 6V14M36 6V14M44 6V14" />
          <path d="M20 50V58M28 50V58M36 50V58M44 50V58" />
          <path d="M6 20H14M6 28H14M6 36H14M6 44H14" />
          <path d="M50 20H58M50 28H58M50 36H58M50 44H58" />
        </g>
        {/* Badan IC silikon */}
        <rect x="14" y="14" width="36" height="36" rx="4" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="2.4" />
        {/* Inti chip berdenyut */}
        <rect
          x="22"
          y="22"
          width="20"
          height="20"
          rx="2"
          fill="var(--slime)"
          stroke="var(--ink)"
          stroke-width="2"
          class="chip-core-pulse"
        />
        {/* Jalur sirkuit emas */}
        <path d="M26 32H38M32 26V38" stroke="var(--mustard)" stroke-width="2" stroke-linecap="round" />
        <circle cx="32" cy="32" r="2.5" fill="var(--ink)" />
        {/* Titik orientasi Pin 1 */}
        <circle cx="18.5" cy="18.5" r="1.5" fill="var(--tomato)" />
      </svg>
    </div>
  )
}

{
  variant === 'gundam' && (
    <div class={`gundam-float inline-flex select-none ${className}`} aria-hidden="true" title="Gundam RX-78 Spirit">
      <svg viewBox="0 0 68 62" fill="none" class="h-12 w-13">
        {/* Helm utama Gundam putih/krem */}
        <path
          d="M17 24L22 12H46L51 24L49 46L34 55L19 46L17 24Z"
          fill="var(--paper)"
          stroke="var(--ink)"
          stroke-width="2.2"
          stroke-linejoin="round"
        />
        {/* Jambul tengah atas + sensor kamera biru */}
        <rect x="29.5" y="7" width="9" height="14" rx="1.5" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
        <rect x="31.5" y="9.5" width="5" height="4.5" fill="var(--slime)" stroke="var(--ink)" stroke-width="1.2" />
        {/* V-Fin Emas Ikonik */}
        <path
          d="M34 24L8 12L12 18L34 29L56 18L60 12L34 24Z"
          fill="var(--mustard)"
          stroke="var(--ink)"
          stroke-width="2"
          stroke-linejoin="round"
        />
        {/* Permata dahi merah */}
        <polygon points="34,20 38,25 34,30 30,25" fill="var(--tomato)" stroke="var(--ink)" stroke-width="1.6" />
        {/* Visor gelap + Dual Eyes kuning berpendar */}
        <path d="M21 31H47L45 38H23L21 31Z" fill="var(--ink)" />
        <polygon points="24,33 32,34.5 31,36.5 24,36" fill="var(--mustard)" class="gundam-eye-glow" />
        <polygon points="44,33 36,34.5 37,36.5 44,36" fill="var(--mustard)" class="gundam-eye-glow" />
        {/* Masker mulut & dagu merah */}
        <path d="M27 42H41M29 46H39" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" />
        <polygon points="30,49 38,49 34,55" fill="var(--tomato)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      </svg>
    </div>
  )
}
