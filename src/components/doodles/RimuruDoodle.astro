---
interface Props {
  variant: 'slime' | 'slime-crown' | 'divider';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;
---

{
  variant === 'slime' && (
    <svg
      viewBox="0 0 88 62"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={`select-none ${className}`}
      role="img"
      aria-label="Rimuru Slime"
    >
      {/* Bayangan bawah lembut */}
      <ellipse cx="44" cy="55" rx="31" ry="4.5" fill="var(--slime-deep)" fill-opacity="0.2" />
      {/* Badan slime biru khas Rimuru */}
      <path
        d="M11 45C11 26 24 12 44 12C64 12 77 26 77 45C77 52.5 65 55 44 55C23 55 11 52.5 11 45Z"
        fill="var(--slime)"
        stroke="var(--ink)"
        stroke-width="2.6"
        stroke-linejoin="round"
      />
      {/* Bayangan dasar dalam gel */}
      <path
        d="M14.5 46.5C19 52 69 52 73.5 46.5C71 51.5 60 53.5 44 53.5C28 53.5 17 51.5 14.5 46.5Z"
        fill="var(--slime-deep)"
        fill-opacity="0.4"
      />
      {/* Kilau gel putih */}
      <ellipse cx="29" cy="24" rx="7.5" ry="4" transform="rotate(-24 29 24)" fill="var(--paper)" fill-opacity="0.82" />
      <circle cx="21.5" cy="31" r="2.2" fill="var(--paper)" fill-opacity="0.82" />
      {/* Ekspresi khas Rimuru Slime (mata garis + pipi) */}
      <path
        d="M30 37.5C32 35.8 35.5 35.8 37.5 37.5"
        stroke="var(--ink)"
        stroke-width="2.6"
        stroke-linecap="round"
      />
      <path
        d="M50.5 37.5C52.5 35.8 56 35.8 58 37.5"
        stroke="var(--ink)"
        stroke-width="2.6"
        stroke-linecap="round"
      />
      <ellipse cx="26.5" cy="41.5" rx="3.5" ry="1.8" fill="var(--blush)" fill-opacity="0.7" />
      <ellipse cx="61.5" cy="41.5" rx="3.5" ry="1.8" fill="var(--blush)" fill-opacity="0.7" />
      {/* Tetesan gel biru mungil di samping */}
      <circle cx="81.5" cy="34" r="2.4" fill="var(--slime)" stroke="var(--ink)" stroke-width="1.6" />
    </svg>
  )
}

{
  variant === 'slime-crown' && (
    <svg
      viewBox="0 0 88 74"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={`select-none ${className}`}
      role="img"
      aria-label="Rimuru Tempest"
    >
      {/* Mahkota emas mungil Tempest */}
      <path
        d="M32 23L34 11L40.5 17L44 8.5L47.5 17L54 11L56 23Z"
        fill="var(--mustard)"
        stroke="var(--ink)"
        stroke-width="2.2"
        stroke-linejoin="round"
      />
      <circle cx="44" cy="18.5" r="1.8" fill="var(--slime-deep)" />
      {/* Bayangan bawah */}
      <ellipse cx="44" cy="67" rx="30" ry="4" fill="var(--slime-deep)" fill-opacity="0.2" />
      {/* Badan slime biru */}
      <path
        d="M12 57C12 38 24.5 24 44 24C63.5 24 76 38 76 57C76 64 64 66.5 44 66.5C24 66.5 12 64 12 57Z"
        fill="var(--slime)"
        stroke="var(--ink)"
        stroke-width="2.6"
        stroke-linejoin="round"
      />
      {/* Kilau gel */}
      <ellipse cx="29" cy="36" rx="7" ry="3.8" transform="rotate(-24 29 36)" fill="var(--paper)" fill-opacity="0.82" />
      <circle cx="22" cy="43" r="2" fill="var(--paper)" fill-opacity="0.82" />
      {/* Mata melengkung ceria khas Rimuru */}
      <path
        d="M30 49.5C32 47.2 35.5 47.2 37.5 49.5"
        stroke="var(--ink)"
        stroke-width="2.6"
        stroke-linecap="round"
      />
      <path
        d="M50.5 49.5C52.5 47.2 56 47.2 58 49.5"
        stroke="var(--ink)"
        stroke-width="2.6"
        stroke-linecap="round"
      />
      <ellipse cx="26.5" cy="53" rx="3.4" ry="1.7" fill="var(--blush)" fill-opacity="0.7" />
      <ellipse cx="61.5" cy="53" rx="3.4" ry="1.7" fill="var(--blush)" fill-opacity="0.7" />
    </svg>
  )
}

{
  variant === 'divider' && (
    <div
      class={`flex items-center justify-center gap-3 py-1 select-none ${className}`}
      aria-hidden="true"
    >
      <span class="h-0.5 flex-1 border-b-2 border-dashed border-slime-deep/35" />
      <span class="h-2 w-2 rounded-full border border-ink bg-slime-soft" />
      <svg viewBox="0 0 60 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-7 w-10 shrink-0">
        <path
          d="M7 31C7 17 16 7 30 7C44 7 53 17 53 31C53 36 45 37.5 30 37.5C15 37.5 7 36 7 31Z"
          fill="var(--slime)"
          stroke="var(--ink)"
          stroke-width="2.2"
        />
        <ellipse cx="20" cy="15.5" rx="5" ry="2.6" transform="rotate(-24 20 15.5)" fill="var(--paper)" fill-opacity="0.8" />
        <path d="M21 25.5C22.5 24.2 24.5 24.2 26 25.5" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
        <path d="M34 25.5C35.5 24.2 37.5 24.2 39 25.5" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
      </svg>
      <span class="h-2 w-2 rounded-full border border-ink bg-slime-soft" />
      <span class="h-0.5 flex-1 border-b-2 border-dashed border-slime-deep/35" />
    </div>
  )
}
