---
/**
 * Dinding Rel Ornamen Kiri & Kanan (khusus layar desktop lebar >= 1280px / xl)
 * - Berbingkai garis lurus tegas (`border-ink`) dengan wilayah warna sendiri (`--wall-bg`)
 * - Kodingan monospace autentik bergerak naik (kiri) & turun (kanan) sangat pelan di latar dinding
 * - 4 kotak ornamen proporsional di tiap dinding (tidak terapung lepas!)
 * - 0 KB JS — CSS & SVG murni, otomatis berhenti saat prefers-reduced-motion.
 */

const leftCodeLines = [
  'const desk = "alam";',
  'rimuru.slurp();',
  'git push origin main',
  'astro check // 0 err',
  'export const rp0 = true;',
  'if (coffee) debug();',
  'theme.switch("rimuru")',
  'batik.kawung(0.08);',
  'laravel.artisan("up");',
  'SELECT * FROM assets;',
  'const night = "met";',
  'slime.isBad = false;',
  'gowes({ km: 12.5 });',
  'npm run build // ok',
];

const rightCodeLines = [
  'ynwa("Liverpool FC");',
  'route("Brebes->Sragen")',
  'wayang.gunungan();',
  'fds.score(tx) // 0.988',
  'opsec.zeroUpload();',
  'cmms.scanQR(asset);',
  'fleet.trackGPS();',
  'gamelan.slendro();',
  'tempest.melody();',
  'cat.purr({ hz: 26 });',
  'status: "MagangHub";',
  'build: 39 pages ok;',
  'const focus = true;',
  'return cleanCode;',
];
---

<div
  class="pointer-events-none fixed inset-0 z-20 hidden overflow-hidden select-none xl:block"
  aria-hidden="true"
>
  {/* ==================== DINDING REL KIRI ==================== */}
  <aside
    class="fixed top-[86px] bottom-0 left-0 flex w-[112px] flex-col border-r-2 border-ink bg-[var(--wall-bg)] transition-colors duration-300"
  >
    {/* Kodingan bergerak NAIK pelan di latar dinding */}
    <div class="pointer-events-none absolute inset-0 overflow-hidden px-2 opacity-22">
      <div class="wall-code-track-up flex flex-col gap-2.5 font-mono text-[9px] leading-tight text-ink">
        {[...leftCodeLines, ...leftCodeLines].map((line) => (
          <span class="truncate">{line}</span>
        ))}
      </div>
    </div>

    {/* Label Header Dinding Kiri */}
    <div class="relative z-10 border-b-2 border-ink bg-paper-2/90 px-2 py-1 text-center font-mono text-[9px] font-bold tracking-widest uppercase text-ink-soft">
      SIDE · A
    </div>

    {/* 4 Kotak Ornamen Berbingkai Rapi (ruang aman pb-16 di atas tombol Audio) */}
    <div class="relative z-10 grid flex-1 grid-rows-4 gap-2.5 px-2.5 pt-2.5 pb-16">
      {/* Kotak 01: Bulan Sabit + Awan Mega Mendung ("The Night We Met") */}
      <div class="flex flex-col items-center justify-center rounded-sm border-2 border-ink bg-[var(--wall-cell)] p-1.5 shadow-[2px_2px_0_var(--ink)]">
        <svg viewBox="0 0 96 78" fill="none" xmlns="http://www.w3.org/2000/svg" class="wall-icon-float h-14 w-16" style="animation-delay:0s;">
          <path
            d="M58 8C45 10 36 20 38 33C40 45 51 52 63 50C53 48 47 40 47 30C47 20 51 13 58 8Z"
            fill="var(--mustard)"
            fill-opacity="0.82"
            stroke="var(--ink)"
            stroke-width="2"
            stroke-linejoin="round"
          />
          <path d="M22 15L24 20L29 22L24 24L22 29L20 24L15 22L20 20L22 15Z" fill="var(--mustard)" stroke="var(--ink)" stroke-width="1.2" />
          <circle cx="76" cy="21" r="2.2" fill="var(--slime)" stroke="var(--ink)" stroke-width="1.2" />
          <path
            d="M12 64C14 54 23 50 32 54C37 47 48 45 56 50C63 46 75 49 79 58C84 59 86 64 83 68H14C10 68 10 65 12 64Z"
            fill="var(--slime)"
            fill-opacity="0.78"
            stroke="var(--ink)"
            stroke-width="2"
            stroke-linejoin="round"
          />
        </svg>
        <span class="mt-1 font-mono text-[8.5px] font-bold tracking-wider uppercase text-ink-soft">
          01 · NIGHT
        </span>
      </div>

      {/* Kotak 02: Kaset Pita Analog */}
      <div class="flex flex-col items-center justify-center rounded-sm border-2 border-ink bg-[var(--wall-cell)] p-1.5 shadow-[2px_2px_0_var(--ink)]">
        <svg viewBox="0 0 92 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="wall-icon-float h-12 w-16" style="animation-delay:0.8s;">
          <rect x="6" y="8" width="80" height="46" rx="5" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="2.2" />
          <rect x="13" y="14" width="66" height="23" rx="2" fill="var(--slime-soft)" stroke="var(--ink)" stroke-width="1.6" />
          <line x1="18" y1="20" x2="54" y2="20" stroke="var(--tomato)" stroke-width="2" stroke-linecap="round" />
          <circle cx="31" cy="31" r="4" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.6" />
          <circle cx="61" cy="31" r="4" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.6" />
          <path d="M35 31H57" stroke="var(--ink)" stroke-width="1.4" stroke-dasharray="2 2" />
          <path d="M24 54L28 44H64L68 54" fill="var(--mustard)" fill-opacity="0.6" stroke="var(--ink)" stroke-width="1.6" />
        </svg>
        <span class="mt-1 font-mono text-[8.5px] font-bold tracking-wider uppercase text-ink-soft">
          02 · TAPE
        </span>
      </div>

      {/* Kotak 03: Rimuru Slime Bermahkota */}
      <div class="flex flex-col items-center justify-center rounded-sm border-2 border-ink bg-[var(--wall-cell)] p-1.5 shadow-[2px_2px_0_var(--ink)]">
        <svg viewBox="0 0 88 66" fill="none" xmlns="http://www.w3.org/2000/svg" class="wall-icon-float h-13 w-16" style="animation-delay:1.2s;">
          <path d="M34 18L36 9L41 13.5L44 7L47 13.5L52 9L54 18Z" fill="var(--mustard)" stroke="var(--ink)" stroke-width="1.8" stroke-linejoin="round" />
          <path
            d="M16 48C16 31 27 19 44 19C61 19 72 31 72 48C72 54 61 56 44 56C27 56 16 54 16 48Z"
            fill="var(--slime)"
            stroke="var(--ink)"
            stroke-width="2.2"
          />
          <ellipse cx="31" cy="29" rx="6" ry="3.2" transform="rotate(-22 31 29)" fill="var(--paper)" fill-opacity="0.82" />
          <path d="M32 41C34 39.3 37 39.3 39 41" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" />
          <path d="M49 41C51 39.3 54 39.3 56 41" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" />
          <ellipse cx="28.5" cy="44.5" rx="3" ry="1.5" fill="var(--blush)" fill-opacity="0.7" />
          <ellipse cx="59.5" cy="44.5" rx="3" ry="1.5" fill="var(--blush)" fill-opacity="0.7" />
        </svg>
        <span class="mt-1 font-mono text-[8.5px] font-bold tracking-wider uppercase text-ink-soft">
          03 · RIMURU
        </span>
      </div>

      {/* Kotak 04: Sepeda Gowes */}
      <div class="flex flex-col items-center justify-center rounded-sm border-2 border-ink bg-[var(--wall-cell)] p-1.5 shadow-[2px_2px_0_var(--ink)]">
        <svg viewBox="0 0 92 52" fill="none" xmlns="http://www.w3.org/2000/svg" class="wall-icon-float h-11 w-16" style="animation-delay:1.6s;">
          <circle cx="24" cy="35" r="11.5" fill="var(--slime-soft)" fill-opacity="0.7" stroke="var(--ink)" stroke-width="2.2" />
          <circle cx="68" cy="35" r="11.5" fill="var(--slime-soft)" fill-opacity="0.7" stroke="var(--ink)" stroke-width="2.2" />
          <circle cx="24" cy="35" r="2.4" fill="var(--ink)" />
          <circle cx="68" cy="35" r="2.4" fill="var(--ink)" />
          <path
            d="M24 35L41 16H58L68 35M41 16L46 35H24M58 16L61 9H69M36 11H45"
            stroke="var(--ink)"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M5 20H16M9 26H15" stroke="var(--slime-deep)" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span class="mt-1 font-mono text-[8.5px] font-bold tracking-wider uppercase text-ink-soft">
          04 · GOWES
        </span>
      </div>
    </div>
  </aside>

  {/* ==================== DINDING REL KANAN ==================== */}
  <aside
    class="fixed top-[86px] right-0 bottom-0 flex w-[112px] flex-col border-l-2 border-ink bg-[var(--wall-bg)] transition-colors duration-300"
  >
    {/* Kodingan bergerak TURUN pelan di latar dinding */}
    <div class="pointer-events-none absolute inset-0 overflow-hidden px-2 opacity-22">
      <div class="wall-code-track-down flex flex-col gap-2.5 font-mono text-[9px] leading-tight text-ink">
        {[...rightCodeLines, ...rightCodeLines].map((line) => (
          <span class="truncate">{line}</span>
        ))}
      </div>
    </div>

    {/* Label Header Dinding Kanan */}
    <div class="relative z-10 border-b-2 border-ink bg-paper-2/90 px-2 py-1 text-center font-mono text-[9px] font-bold tracking-widest uppercase text-ink-soft">
      SIDE · B
    </div>

    {/* 4 Kotak Ornamen Berbingkai Rapi (ruang aman pb-16 di atas tombol Kucing) */}
    <div class="relative z-10 grid flex-1 grid-rows-4 gap-2.5 px-2.5 pt-2.5 pb-16">
      {/* Kotak 05: Gunungan Wayang */}
      <div class="flex flex-col items-center justify-center rounded-sm border-2 border-ink bg-[var(--wall-cell)] p-1.5 shadow-[2px_2px_0_var(--ink)]">
        <svg viewBox="0 0 76 86" fill="none" xmlns="http://www.w3.org/2000/svg" class="wall-icon-float h-14 w-13" style="animation-delay:0.6s;">
          <path
            d="M38 5C51 20 63 35 65 58C65.5 64 61 70 54 72H22C15 70 10.5 64 11 58C13 35 25 20 38 5Z"
            fill="var(--mustard)"
            fill-opacity="0.38"
            stroke="var(--ink)"
            stroke-width="2.2"
            stroke-linejoin="round"
          />
          <path d="M38 15V72" stroke="var(--ink)" stroke-width="1.8" stroke-linecap="round" />
          <path
            d="M38 28C30 29 25 35 22 42M38 28C46 29 51 35 54 42M38 43C29 44 23 50 20 58M38 43C47 44 53 50 56 58"
            stroke="var(--ink)"
            stroke-width="1.6"
            stroke-linecap="round"
          />
          <path d="M30 72V59H46V72" fill="var(--slime-soft)" stroke="var(--ink)" stroke-width="1.8" stroke-linejoin="round" />
          <path d="M38 72V82" stroke="var(--ink)" stroke-width="2.6" stroke-linecap="round" />
        </svg>
        <span class="mt-1 font-mono text-[8.5px] font-bold tracking-wider uppercase text-ink-soft">
          05 · WAYANG
        </span>
      </div>

      {/* Kotak 06: Cap Pos Brebes -> Sragen */}
      <div class="flex flex-col items-center justify-center rounded-sm border-2 border-ink bg-[var(--wall-cell)] p-1.5 shadow-[2px_2px_0_var(--ink)]">
        <svg viewBox="0 0 84 84" fill="none" xmlns="http://www.w3.org/2000/svg" class="wall-icon-float h-14 w-14" style="animation-delay:1.1s;">
          <circle cx="42" cy="42" r="35" fill="var(--paper-2)" stroke="var(--cobalt)" stroke-width="2" stroke-dasharray="5 3" />
          <circle cx="42" cy="42" r="27" stroke="var(--cobalt)" stroke-width="1.4" />
          <text x="42" y="35" text-anchor="middle" fill="var(--ink)" font-family="monospace" font-size="8.5" font-weight="700">
            BREBES
          </text>
          <path d="M25 42H59" stroke="var(--tomato)" stroke-width="1.6" stroke-linecap="round" />
          <text x="42" y="53" text-anchor="middle" fill="var(--ink)" font-family="monospace" font-size="8.5" font-weight="700">
            SRAGEN
          </text>
          <circle cx="42" cy="42" r="2.2" fill="var(--mustard)" stroke="var(--ink)" stroke-width="1" />
        </svg>
        <span class="mt-1 font-mono text-[8.5px] font-bold tracking-wider uppercase text-ink-soft">
          06 · JATENG
        </span>
      </div>

      {/* Kotak 07: Bola + Syal Merah Liverpool (YNWA) */}
      <div class="flex flex-col items-center justify-center rounded-sm border-2 border-ink bg-[var(--wall-cell)] p-1.5 shadow-[2px_2px_0_var(--ink)]">
        <svg viewBox="0 0 92 68" fill="none" xmlns="http://www.w3.org/2000/svg" class="wall-icon-float h-13 w-16" style="animation-delay:1.8s;">
          <rect x="8" y="40" width="76" height="20" rx="4" fill="var(--tomato)" stroke="var(--ink)" stroke-width="2" />
          <text x="46" y="53.5" text-anchor="middle" fill="#fff8ec" font-family="monospace" font-size="10.5" font-weight="800">
            ★ YNWA ★
          </text>
          <circle cx="46" cy="22" r="15" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.2" />
          <polygon points="46,14.5 52.5,19 50,26.5 42,26.5 39.5,19" fill="var(--ink)" />
          <path
            d="M46 7V14.5M60 17.5L52.5 19M55 34L50 26.5M37 34L42 26.5M32 17.5L39.5 19"
            stroke="var(--ink)"
            stroke-width="1.5"
          />
        </svg>
        <span class="mt-1 font-mono text-[8.5px] font-bold tracking-wider uppercase text-ink-soft">
          07 · LFC
        </span>
      </div>

      {/* Kotak 08: Siluet Hutan Pinus & Bintang Malam */}
      <div class="flex flex-col items-center justify-center rounded-sm border-2 border-ink bg-[var(--wall-cell)] p-1.5 shadow-[2px_2px_0_var(--ink)]">
        <svg viewBox="0 0 92 68" fill="none" xmlns="http://www.w3.org/2000/svg" class="wall-icon-float h-13 w-16" style="animation-delay:2.2s;">
          <circle cx="46" cy="34" r="29" fill="var(--slime-soft)" stroke="var(--ink)" stroke-width="2" />
          <circle cx="31" cy="19" r="2.2" fill="var(--mustard)" class="tensura-twinkle" />
          <circle cx="61" cy="17" r="2.4" fill="var(--mustard)" class="tensura-twinkle" style="--t-delay:0.8s;" />
          <circle cx="47" cy="13" r="1.4" fill="var(--ink)" />
          <path d="M29 54L36 32L43 54Z" fill="var(--ink)" fill-opacity="0.82" />
          <path d="M40 58L49 24L58 58Z" fill="var(--ink)" />
          <path d="M54 54L61 36L68 54Z" fill="var(--ink)" fill-opacity="0.78" />
          <path d="M23 53H69" stroke="var(--slime)" stroke-width="2.2" stroke-linecap="round" />
        </svg>
        <span class="mt-1 font-mono text-[8.5px] font-bold tracking-wider uppercase text-ink-soft">
          08 · PINES
        </span>
      </div>
    </div>
  </aside>
</div>
