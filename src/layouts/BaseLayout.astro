---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import '@fontsource/kalam/400.css';
import '@fontsource/kalam/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import TerminalModal from '../components/islands/TerminalModal';
import CatCompanion from '../components/islands/CatCompanion';
import DeskAudio from '../components/islands/DeskAudio';
import RimuruDoodle from '../components/doodles/RimuruDoodle.astro';
import CultureOrnaments from '../components/doodles/CultureOrnaments.astro';
import MidnightAtmosphere from '../components/doodles/MidnightAtmosphere.astro';
import SideMarginOrnaments from '../components/doodles/SideMarginOrnaments.astro';
import TensuraAmbientSquares from '../components/doodles/TensuraAmbientSquares.astro';
import PageAmbientOrnaments from '../components/doodles/PageAmbientOrnaments.astro';
import TechHobbyOrnaments from '../components/doodles/TechHobbyOrnaments.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import {
  getProfileData,
  getProjectsData,
  getSkillsData,
  pickLocale,
} from '../lib/content';
import type { TerminalContext } from '../lib/terminalEngine';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portfolio Baharudin Alamsyah (Alam) — Web programmer, pembelajar mobile & AI, eksplorator game dev & jaringan.',
} = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const otherLocale = locale === 'id' ? 'en' : 'id';
const switchHref = getLocalizedPath(Astro.url.pathname, otherLocale);
const homeHref = getLocalizedPath('/', locale);
const projectsHref = getLocalizedPath('/projects', locale);
const tokoHref = getLocalizedPath('/toko', locale);
const notesHref = getLocalizedPath('/notes', locale);
const nowHref = getLocalizedPath('/now', locale);
const logHref = getLocalizedPath('/log', locale);
const cleanPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const pageKind = cleanPath.startsWith('/notes')
  ? 'notes'
  : cleanPath.startsWith('/toko')
    ? 'toko'
    : cleanPath.startsWith('/projects')
      ? 'projects'
      : cleanPath.startsWith('/now') || cleanPath.startsWith('/log')
        ? 'logbook'
        : 'home';
const siteBase = (Astro.site?.toString() ?? 'https://baharudin-alamsyah.vercel.app').replace(/\/$/, '');
const canonicalUrl = `${siteBase}${Astro.url.pathname}`;
const ogImageUrl = `${siteBase}/og/cover.svg`;

const [profile, projects, skills] = await Promise.all([
  getProfileData(),
  getProjectsData(false),
  getSkillsData(),
]);

const terminalContext: TerminalContext = {
  locale,
  profile: {
    name: profile?.name ?? 'Baharudin Alamsyah',
    nickname: profile?.nickname ?? 'Alam',
    role: pickLocale(profile?.role, locale) || 'Web developer',
    bio: pickLocale(profile?.bio, locale),
    location: profile?.location ?? 'Indonesia',
    email: profile?.email ?? '',
    cvUrl: profile?.cvUrl ?? '',
    socials: profile?.socials ?? [],
    jogging: {
      totalKm: profile?.jogging?.totalKm ?? 0,
      favoriteRoute: profile?.jogging?.favoriteRoute ?? '',
      note: pickLocale(profile?.jogging?.note, locale),
    },
  },
  projects: projects.map((p) => ({
    slug: p.id,
    title: p.data.title,
    category: p.data.category,
    status: p.data.status,
    stack: p.data.stack,
    summary: pickLocale(p.data.summary, locale),
    href: getLocalizedPath(`/projects/${p.id}`, locale),
  })),
  skills: skills.map((s) => ({
    name: s.name,
    category: s.category,
    level: s.level,
  })),
};
---

<!doctype html>
<html lang={locale} data-audience="semua" data-theme="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('alam-theme');
        const theme =
          saved === 'day' || saved === 'rimuru' || saved === 'midnight' ? saved : 'day';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph & Twitter Card -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Person -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile?.name ?? 'Baharudin Alamsyah',
        alternateName: profile?.nickname ?? 'Alam',
        url: siteBase,
        jobTitle: 'Web Developer',
        knowsAbout: ['Web Programming', 'Mobile Development', 'AI Integration', 'Game Development', 'Computer Networking'],
        sameAs: (profile?.socials ?? []).map((s) => s.url).filter(Boolean),
      })}
    />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body data-page={pageKind} class="flex min-h-dvh flex-col">
    <a
      href="#main-content"
      class="bg-mustard text-ink sr-only fixed top-3 left-3 z-50 border-2 border-ink px-3 py-1.5 text-sm font-semibold focus:not-sr-only"
    >
      {t('skip.content')}
    </a>

    <header class="border-b-2 border-ink bg-paper/95 sticky top-0 z-40">
      <CultureOrnaments variant="megamendung-ribbon" />
      <div class="flex items-stretch">
        {/* Sayap Kiri Header (Desktop lebar, sejajar dinding SIDE · A) */}
        <div
          class="hidden w-[112px] shrink-0 items-center justify-center gap-1.5 border-r-2 border-ink bg-[var(--wall-bg)] px-2 font-mono text-[9.5px] font-bold text-ink-soft xl:flex"
          aria-hidden="true"
        >
          <span class="h-2 w-2 rounded-full border border-ink bg-tomato"></span>
          <span class="h-2 w-2 rounded-full border border-ink bg-mustard"></span>
          <span class="h-2 w-2 rounded-full border border-ink bg-leaf"></span>
          <span class="ml-0.5 truncate">&lt;/&gt;</span>
        </div>

        <div class="mx-auto flex w-full max-w-5xl flex-1 items-center justify-between gap-3 px-4 py-2.5 sm:px-5">
          <div class="flex items-center gap-2.5">
            <a
              href={homeHref}
              class="font-display inline-flex items-center gap-2 text-lg font-bold tracking-tight"
            >
              <span
                class="bg-tomato text-paper inline-flex h-7 w-7 items-center justify-center rounded-sm border-2 border-ink text-sm font-bold shadow-[2px_2px_0_var(--ink)]"
                aria-hidden="true"
              >
                A
              </span>
              <span>alam.</span>
            </a>

            {/* Badge IDE / Git di sebelah logo */}
            <button
              type="button"
              data-open-terminal
              title={locale === 'id' ? 'Klik untuk buka Terminal (Ctrl+K)' : 'Click to open Terminal (Ctrl+K)'}
              class="hidden items-center gap-1.5 rounded-sm border border-ink/40 bg-paper-2 px-2 py-0.5 font-mono text-[11px] text-ink-soft transition-colors hover:border-ink hover:text-ink sm:inline-flex"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-leaf" aria-hidden="true"></span>
              <span>~/alam</span>
              <span class="text-cobalt font-semibold">⎇ main</span>
              <span class="cursor-blink bg-tomato inline-block h-3 w-1.5" aria-hidden="true"></span>
            </button>
          </div>

          <nav aria-label="Navigasi utama" class="flex items-center gap-2 sm:gap-3">
          <div class="hidden items-center gap-4 pr-2 text-sm font-semibold text-ink md:flex">
            <a href={projectsHref} class="hover:text-tomato transition-colors">
              {t('nav.projects')}
            </a>
            <a href={tokoHref} class="hover:text-tomato transition-colors">
              {t('nav.shop')}
            </a>
            <a href={notesHref} class="hover:text-tomato transition-colors">
              {t('nav.notes')}
            </a>
            <a href={`${homeHref}#skills`} class="hover:text-tomato transition-colors">
              {t('nav.skills')}
            </a>
            <a href={`${homeHref}#about`} class="hover:text-tomato transition-colors">
              {t('nav.about')}
            </a>
            <a href={`${homeHref}#passport`} class="hover:text-tomato transition-colors">
              {t('nav.passport')}
            </a>
            <a href={`${homeHref}#contact`} class="hover:text-tomato transition-colors">
              {t('nav.contact')}
            </a>
          </div>

          <button
            type="button"
            data-theme-toggle
            aria-label={
              locale === 'id'
                ? 'Ganti tema (Krem / Rimuru / Malam)'
                : 'Switch theme (Cream / Rimuru / Night)'
            }
            title={
              locale === 'id'
                ? 'Klik untuk ganti tema: Krem → Rimuru → Malam'
                : 'Click to cycle theme: Cream → Rimuru → Night'
            }
            class="sticker-btn bg-paper-2 text-ink rounded-sm px-2.5 py-1 font-mono text-xs"
          >
            <span data-theme-icon aria-hidden="true">☀️</span>
            <span data-theme-label class="hidden sm:inline">
              {locale === 'id' ? 'Krem' : 'Cream'}
            </span>
          </button>

          <a
            href={switchHref}
            aria-label={t('nav.langLabel')}
            class="sticker-btn bg-paper-2 text-ink rounded-sm px-2.5 py-1 font-mono text-xs uppercase"
          >
            {otherLocale.toUpperCase()}
          </a>

          <button
            type="button"
            data-open-terminal
            class="sticker-btn bg-ink text-paper inline-flex items-center gap-1.5 rounded-sm px-2.5 py-1 font-mono text-xs"
            aria-label="Buka Terminal Mode (Ctrl+K)"
          >
            <span class="text-mustard font-bold">&gt;_</span>
            <span class="hidden opacity-85 sm:inline">Ctrl+K</span>
          </button>

          {/* Tombol Menu Navigasi khusus HP */}
          <button
            type="button"
            data-mobile-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            aria-label={locale === 'id' ? 'Buka menu navigasi' : 'Open navigation menu'}
            class="sticker-btn bg-mustard text-ink inline-flex items-center justify-center rounded-sm px-2.5 py-1 font-mono text-xs font-bold md:hidden"
          >
            <span data-mobile-menu-icon aria-hidden="true">☰</span>
          </button>
        </nav>
        </div>

        {/* Sayap Kanan Header (Desktop lebar, sejajar dinding SIDE · B) */}
        <div
          class="hidden w-[112px] shrink-0 items-center justify-center gap-1 border-l-2 border-ink bg-[var(--wall-bg)] px-2 font-mono text-[9.5px] font-bold text-ink-soft xl:flex"
          aria-hidden="true"
        >
          <span class="h-2 w-2 rounded-full border border-ink bg-slime"></span>
          <span>&#123; code: ok &#125;</span>
        </div>
      </div>

      {/* Status Bar Tipis ala VS Code + Ticker Kodingan */}
      <div
        class="flex h-[22px] items-center justify-between gap-3 overflow-hidden border-t border-ink/25 bg-paper-2/95 px-3 font-mono text-[10px] text-ink-soft sm:px-5"
        aria-hidden="true"
      >
        <div class="flex shrink-0 items-center gap-2.5">
          <span class="inline-flex items-center gap-1 font-bold text-ink">
            <span class="h-1.5 w-1.5 rounded-full bg-leaf"></span>
            0 errors
          </span>
          <span class="hidden sm:inline">·</span>
          <span class="hidden text-cobalt font-semibold sm:inline">TypeScript strict</span>
          <span class="hidden md:inline">·</span>
          <span class="hidden md:inline">Astro + Preact</span>
        </div>

        <div class="min-w-0 flex-1 overflow-hidden">
          <div class="header-code-marquee gap-6 text-[10px] opacity-80">
            <span>const desk = &quot;alam&quot;;</span>
            <span>·</span>
            <span>git push origin main</span>
            <span>·</span>
            <span>astro check // 0 errors</span>
            <span>·</span>
            <span>rimuru.slurp()</span>
            <span>·</span>
            <span>ynwa(&quot;LFC&quot;)</span>
            <span>·</span>
            <span>const desk = &quot;alam&quot;;</span>
            <span>·</span>
            <span>git push origin main</span>
            <span>·</span>
            <span>astro check // 0 errors</span>
            <span>·</span>
            <span>rimuru.slurp()</span>
            <span>·</span>
            <span>ynwa(&quot;LFC&quot;)</span>
            <span>·</span>
          </div>
        </div>

        <span class="hidden shrink-0 text-[9.5px] sm:inline">UTF-8 · LF</span>
      </div>

      {/* Panel Menu Navigasi Khusus HP */}
      <nav
        id="mobile-nav-drawer"
        data-mobile-menu
        aria-label={locale === 'id' ? 'Menu navigasi seluler' : 'Mobile navigation'}
        class="hidden border-t-2 border-ink bg-paper px-4 py-3 shadow-[0_6px_0_var(--ink)] md:hidden"
      >
        <div class="grid grid-cols-2 gap-2 font-mono text-xs font-bold">
          <a href={projectsHref} class="rounded-sm border-2 border-ink bg-paper-2 px-3 py-2 text-ink hover:bg-mustard">
            {t('nav.projects')}
          </a>
          <a href={tokoHref} class="rounded-sm border-2 border-ink bg-paper-2 px-3 py-2 text-ink hover:bg-mustard">
            {t('nav.shop')}
          </a>
          <a href={notesHref} class="rounded-sm border-2 border-ink bg-paper-2 px-3 py-2 text-ink hover:bg-mustard">
            {t('nav.notes')}
          </a>
          <a href={`${homeHref}#skills`} class="rounded-sm border-2 border-ink bg-paper-2 px-3 py-2 text-ink hover:bg-mustard">
            {t('nav.skills')}
          </a>
          <a href={`${homeHref}#about`} class="rounded-sm border-2 border-ink bg-paper-2 px-3 py-2 text-ink hover:bg-mustard">
            {t('nav.about')}
          </a>
          <a href={`${homeHref}#passport`} class="rounded-sm border-2 border-ink bg-paper-2 px-3 py-2 text-ink hover:bg-mustard">
            {t('nav.passport')}
          </a>
          <a href={`${homeHref}#contact`} class="rounded-sm border-2 border-ink bg-tomato px-3 py-2 text-paper">
            {t('nav.contact')}
          </a>
          <a href={nowHref} class="rounded-sm border-2 border-ink bg-slime-soft px-3 py-2 text-ink">
            /now · /log
          </a>
        </div>
      </nav>

      {/* Garis Progres Baca (Biru Rimuru) */}
      <div class="h-[3px] w-full bg-transparent" aria-hidden="true">
        <div
          data-scroll-progress
          class="h-full w-0 bg-slime-deep transition-[width] duration-75"
        ></div>
      </div>
    </header>

    <main id="main-content" class="relative z-10 mx-auto w-full max-w-5xl flex-1 px-5 py-10 sm:py-14">
      <slot />
    </main>

    <footer class="relative z-10 border-t-2 border-ink bg-paper-2">
      <TechHobbyOrnaments variant="train-track" />
      <CultureOrnaments variant="batik-ribbon" class="rounded-none border-b border-ink/30" />
      <div
        class="mx-auto flex max-w-5xl flex-col gap-3 px-5 py-6 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-center gap-2.5">
          <RimuruDoodle
            variant="slime-crown"
            class="h-8 w-10 shrink-0 transition-transform duration-200 hover:-translate-y-1"
          />
          <p>{t('footer.note')}</p>
        </div>
        <div class="flex flex-wrap items-center gap-4 font-mono text-xs">
          <a href={tokoHref} class="text-ink hover:text-tomato underline underline-offset-4">
            /toko
          </a>
          <a href={notesHref} class="text-ink hover:text-tomato underline underline-offset-4">
            /notes
          </a>
          <a href={nowHref} class="text-ink hover:text-tomato underline underline-offset-4">
            /now
          </a>
          <a href={logHref} class="text-ink hover:text-tomato underline underline-offset-4">
            /log
          </a>
          <span>
            Astro + Preact + Tailwind v4 · <span class="text-ink font-semibold">Rp0 stack</span>
          </span>
          <CultureOrnaments variant="gunungan" class="hidden h-7 w-6 shrink-0 sm:block" />
        </div>
      </div>
    </footer>

    <MidnightAtmosphere />
    {pageKind === 'home' ? <TensuraAmbientSquares /> : <PageAmbientOrnaments pageKind={pageKind} />}
    <SideMarginOrnaments />

    <TerminalModal client:idle context={terminalContext} />
    <CatCompanion client:idle locale={locale} />
    <DeskAudio client:idle locale={locale} transition:persist="desk-audio" />

    {/* Tombol Kembali ke Atas (Roket) */}
    <button
      type="button"
      data-scroll-top
      aria-label={locale === 'id' ? 'Kembali ke atas' : 'Back to top'}
      title={locale === 'id' ? 'Kembali ke atas' : 'Back to top'}
      class="sticker-btn bg-slime text-ink pointer-events-none fixed right-4 bottom-16 z-40 translate-y-2 rounded-sm px-2.5 py-1.5 font-mono text-xs font-bold opacity-0 transition-all duration-200"
    >
      <span aria-hidden="true">🚀</span>
      <span class="hidden sm:inline">{locale === 'id' ? 'Atas' : 'Top'}</span>
    </button>

    <script>
      import { initDeskEffects } from '../lib/deskEffects';
      initDeskEffects();

      const THEMES = ['day', 'rimuru', 'midnight'] as const;
      type ThemeName = (typeof THEMES)[number];

      const applySavedTheme = () => {
        const saved = localStorage.getItem('alam-theme');
        const theme: ThemeName =
          saved === 'day' || saved === 'rimuru' || saved === 'midnight' ? saved : 'day';
        document.documentElement.dataset.theme = theme;
        const isEn = document.documentElement.lang === 'en';
        const icon = document.querySelector<HTMLElement>('[data-theme-icon]');
        const label = document.querySelector<HTMLElement>('[data-theme-label]');
        const meta: Record<ThemeName, { icon: string; id: string; en: string }> = {
          day: { icon: '☀️', id: 'Krem', en: 'Cream' },
          rimuru: { icon: '💧', id: 'Rimuru', en: 'Rimuru' },
          midnight: { icon: '🌙', id: 'Malam', en: 'Night' },
        };
        if (icon) icon.textContent = meta[theme].icon;
        if (label) label.textContent = isEn ? meta[theme].en : meta[theme].id;
      };

      const bindThemeToggle = () => {
        applySavedTheme();
        const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
        if (!btn || btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          const curr = (document.documentElement.dataset.theme || 'day') as ThemeName;
          const next = THEMES[(THEMES.indexOf(curr) + 1) % THEMES.length];
          localStorage.setItem('alam-theme', next);
          applySavedTheme();
        });
      };

      const bindHeaderUtilities = () => {
        // Mobile menu drawer
        const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
        const drawer = document.querySelector<HTMLElement>('[data-mobile-menu]');
        const icon = document.querySelector<HTMLElement>('[data-mobile-menu-icon]');
        if (toggle && drawer && toggle.dataset.bound !== 'true') {
          toggle.dataset.bound = 'true';
          const setMenu = (open: boolean) => {
            drawer.classList.toggle('hidden', !open);
            toggle.setAttribute('aria-expanded', String(open));
            if (icon) icon.textContent = open ? '✕' : '☰';
          };
          toggle.addEventListener('click', () => {
            setMenu(drawer.classList.contains('hidden'));
          });
          drawer.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => setMenu(false));
          });
        }

        // Back-to-top button
        const topBtn = document.querySelector<HTMLButtonElement>('[data-scroll-top]');
        if (topBtn && topBtn.dataset.bound !== 'true') {
          topBtn.dataset.bound = 'true';
          topBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // Scroll progress bar + back-to-top visibility
        const updateScrollUI = () => {
          const bar = document.querySelector<HTMLElement>('[data-scroll-progress]');
          const btn = document.querySelector<HTMLElement>('[data-scroll-top]');
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight =
            document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
          if (bar) bar.style.width = `${pct.toFixed(1)}%`;
          if (btn) {
            const show = scrollTop > 350;
            btn.classList.toggle('opacity-0', !show);
            btn.classList.toggle('pointer-events-none', !show);
            btn.classList.toggle('translate-y-2', !show);
          }
        };

        if (!(window as unknown as { __alamScrollBound?: boolean }).__alamScrollBound) {
          (window as unknown as { __alamScrollBound?: boolean }).__alamScrollBound = true;
          window.addEventListener('scroll', updateScrollUI, { passive: true });
        }
        updateScrollUI();
      };

      document.addEventListener('astro:after-swap', applySavedTheme);
      document.addEventListener('astro:page-load', () => {
        bindThemeToggle();
        bindHeaderUtilities();
      });
      bindThemeToggle();
      bindHeaderUtilities();
    </script>
  </body>
</html>
